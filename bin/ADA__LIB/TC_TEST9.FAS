	include '../../src/expander/fasmg/codi_x86_64.finc'
STANDARD = 'STANDARD'
namespace STANDARD
  virtual at 8
    VARzone::
  end virtual
	LINK	0, loc_siz
	VAR	CTX9_disp, 64
	VAR	TOP9_disp, Q
	VAR	G9_disp, Q
	EXC_MACH	0, CTX9_disp
	LCA	h9_
	SA	0, CTX9_disp + 8
	LVA	0, CTX9_disp
	SA	0, TOP9_disp
	LI	7
	SQ	0, G9_disp
	CALL	STANDARD., SP9
	SYS_EXIT	2
exc_raise9_:
	EXC_RAISE	TOP9_disp
h9_:
	LQ	0, G9_disp
	LI	7
	CEQ
	BT	ok9
	SYS_EXIT	1
ok9:
	SYS_EXIT	0
if defined SP9_
	PRO	SP9
	ELB	1
	VAR	T9_disp, Q
	LI	13
	SQ	1, T9_disp
	BRA	exc_raise9_
	UNLINK	1
	RTD	0
	endPRO
end if
 virtual VARzone
   loc_siz = $
  end virtual
end namespace
