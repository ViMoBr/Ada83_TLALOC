L190:
L189:					; post if
	LVA  0,	STANDARD.IDL.PAGE_MAN.WORK_FILE_disp
	CALL	STANDARD.IDL.PAGE_MAN.PAGE_IO. ,CLOSE_L3
ret_lbl:
	UNLINKR 1
	RTD
excep:
endPRO					;---------- end PRO CLOSE_PAGE_MANAGER
end if

