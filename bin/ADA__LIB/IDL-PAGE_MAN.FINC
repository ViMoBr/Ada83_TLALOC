	LID	0, STANDARD.IDL.PAGE_MAN.PAG__u, STANDARD.IDL.PAGE_MAN._PAG__type.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LID	0, STANDARD.IDL.PAGE_MAN.PAG__u, STANDARD.IDL.PAGE_MAN._PAG__type.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LVA	, STANDARD.IDL.PAGE_MAN._RPG_DATA.CHANGED
	LI	1
	SB
	BRA	L185
L186:
L185:					; post if
	UNLINKR 2
endPRO
VAR	IL188_disp, D				; compteur boucle LOOP__5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SD  1,	IL188_disp
VAR	LMT_IL188_disp, D			; limite boucle LOOP__5
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	50
	SD  1,	LMT_IL188_disp
	ULD  1,	IL188_disp				; test null range LOOP__5
	ULD  1,	LMT_IL188_disp
	CGT
	BT	L187
LOOP__5:					; corps boucle LOOP__5
	ULD  1,	IL188_disp
	DUP
	ULD	0, STANDARD.IDL.PAGE_MAN._RPG_NUM.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULD	0, STANDARD.IDL.PAGE_MAN._RPG_NUM.LST
	CGT
	BT	STANDARD.ce_raise_
	CALL	STANDARD.IDL.PAGE_MAN. ,FREE_PAGE_L79
	ULD  1,	IL188_disp				; test de sortie LOOP__5
	ULD  1,	LMT_IL188_disp
	CEQ
	BT	L187
	ULD  1,	IL188_disp				; mise a jour compteur LOOP__5
	INC
	SD  1,	IL188_disp
	BRA	LOOP__5				; iteration suivante LOOP__5
L187:					; post loop LOOP__5
					; debut if
	ULB 0,	STANDARD.IDL.PAGE_MAN.PAGE_MAN_DEBUG_disp
	BF	L190
STR STR_L191, "page_man : close_page_manager"	; constante string="page_man : close_page_manager"
	LCA	STR_L191.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
