PRO	CLOSE_PAGE_MANAGER_L19			;---------- PRO CLOSE_PAGE_MANAGER
 hexa_show 'CLOSE_PAGE_MANAGER_L19 ', $
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
namespace	BLOCK__4
ELB 2					;    BODY ELAB
 hexa_show 'var elab RP ', $
VAR RP_disp, D				; variable entiere
	LI	0					; lieu resultat sur pile
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	DUP
	ULW	0, STANDARD.IDL.PAGE_MAN._VPG_NUM.FST
	CLT
