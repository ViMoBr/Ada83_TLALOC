_FILE_NAME_BUFFER = '_FILE_NAME_BUFFER'
namespace _FILE_NAME_BUFFER			; _FILE_NAME_BUFFER CONSTRAINED ARRAY SUBTYPE INFO
VAR use__info, Q
VAR SIZ__, D
	LVA	0, SIZ__
	SA	0, use__info
VAR _COMP_SIZ, D
VAR _FST_1, D
VAR _LST_1, D
	LI	8
	SD	0, _COMP_SIZ
	LD	0, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SD	0, _FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	256
	SD	0, _LST_1
	LD	0, _LST_1
	LD	0, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	SD	0, SIZ__
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace

					; _FILE_TYPE RECORD TYPE INFO
_FILE_TYPE = '_FILE_TYPE'
namespace _FILE_TYPE
VAR use__info, Q
VAR SIZ__, D
	LVA	0, SIZ__
	SA	0, use__info
USEINFO 0, ID, 	LA 0, STANDARD._INTEGER.use__info
USEINFO 0, NAME, 	LA 0, STANDARD.IDL.PAGE_MAN.PAGE_IO._FILE_NAME_BUFFER.use__info
USEINFO 0, NAME_LEN, 	LA 0, STANDARD._POSITIVE.use__info
USEINFO 0, IS_OPENED, 	LA 0, STANDARD._BOOLEAN.use__info
USEINFO 0, MODE, 	LA 0, STANDARD.IDL.PAGE_MAN.PAGE_IO._FILE_MODE.use__info
USEINFO 0, INDEX, 	LA 0, STANDARD.IDL.PAGE_MAN._POSITIVE_COUNT.use__info
USEINFO 0, AT_END_OF_FILE, 	LA 0, STANDARD._BOOLEAN.use__info
virtual at 0				; calcul des offsets statiques
STATOFS ID, 4, 4
STATOFS NAME, 256, 1
STATOFS NAME_LEN, 4, 4
STATOFS IS_OPENED, 1, 1
STATOFS MODE, 1, 1
STATOFS INDEX, 4, 4
STATOFS AT_END_OF_FILE, 1, 1
size = $
end virtual
	LI	 size*8
	SD	0, SIZ__
end namespace
					;---------- end generic package instantiation PAGE_IO
end namespace


