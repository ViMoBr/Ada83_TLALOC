					; _GRMR_TBL_RECORD RECORD TYPE INFO
_GRMR_TBL_RECORD = '_GRMR_TBL_RECORD'
namespace _GRMR_TBL_RECORD
VAR use__info, Q
VAR SIZ__, D
	LVA	0, SIZ__
	SA	0, use__info
USEINFO 0, ST_TBL, 	LA 0, STANDARD.GRMR_TBL._ST_TBL_TYPE.use__info
USEINFO 0, ST_TBL_LAST, 	LA 0, STANDARD._INTEGER.use__info
USEINFO 0, AC_SYM, 	LA 0, STANDARD.GRMR_TBL._AC_SYM_TYPE.use__info
USEINFO 0, AC_TBL, 	LA 0, STANDARD.GRMR_TBL._AC_TBL_TYPE.use__info
USEINFO 0, AC_SYM_LAST, 	LA 0, STANDARD._INTEGER.use__info
USEINFO 0, AC_TBL_LAST, 	LA 0, STANDARD._INTEGER.use__info
USEINFO 0, NTER_PG, 	LA 0, STANDARD.GRMR_TBL._NTER_PG_TYPE.use__info
USEINFO 0, NTER_LN, 	LA 0, STANDARD.GRMR_TBL._NTER_LN_TYPE.use__info
USEINFO 0, NTER_LAST, 	LA 0, STANDARD._INTEGER.use__info
virtual at 0				; calcul des offsets statiques
STATOFS ST_TBL, 4000, 4
STATOFS ST_TBL_LAST, 4, 4
STATOFS AC_SYM, 4800, 1
STATOFS AC_TBL, 12000, 2
STATOFS AC_SYM_LAST, 4, 4
STATOFS AC_TBL_LAST, 4, 4
STATOFS NTER_PG, 255, 1
STATOFS NTER_LN, 255, 1
STATOFS NTER_LAST, 4, 4
size = $
end virtual
	LI	 size*8
	SD	0, SIZ__
end namespace
 hexa_show 'var elab GRMR ', $
VAR GRMR_disp, Q				; variable record : pointeur aux data record
VAR GRMR__u, Q				; variable record : pointeur aux useinfo
VAR GRMR__dat, STANDARD.GRMR_TBL._GRMR_TBL_RECORD.size
	LVA	0, GRMR__dat
	SA	0, GRMR_disp				; record fin
	LVA	0, STANDARD.GRMR_TBL._GRMR_TBL_RECORD.SIZ__
	SA	0, GRMR__u

 hexa_show ' disp ', GRMR_disp
GRMR_TBL_IO = 'GRMR_TBL_IO'
namespace GRMR_TBL_IO			;---------- GENERIC PACKAGE INSTANTIATION
elab_spec:				;    SPEC ELAB

; F4A SET  cle=ELEMENT_TYPE  actuel=DN_RECORD
BRA post_LD_ELEMENT_TYPE
LD_ELEMENT_TYPE.elab:
	LI 0
	RTD 0
post_LD_ELEMENT_TYPE:
BRA post_ST_ELEMENT_TYPE
ST_ELEMENT_TYPE.elab:
	DROP
	RTD 0
post_ST_ELEMENT_TYPE:
BRA post_INADR_ELEMENT_TYPE
INADR_ELEMENT_TYPE.elab:
	LIA
	RTD 0
post_INADR_ELEMENT_TYPE:
BRA post_OUTADR_ELEMENT_TYPE
OUTADR_ELEMENT_TYPE.elab:
	LIA
	RTD 0
post_OUTADR_ELEMENT_TYPE:
VAR ELEMENT_TYPE__outadr_ofs, Q
	LCA OUTADR_ELEMENT_TYPE.elab
	SA	 0, ELEMENT_TYPE__outadr_ofs
VAR ELEMENT_TYPE__inadr_ofs, Q
	LCA INADR_ELEMENT_TYPE.elab
	SA	 0, ELEMENT_TYPE__inadr_ofs
VAR ELEMENT_TYPE__st_ofs, Q
	LCA ST_ELEMENT_TYPE.elab
	SA	 0, ELEMENT_TYPE__st_ofs
VAR ELEMENT_TYPE__ld_ofs, Q
	LCA LD_ELEMENT_TYPE.elab
	SA	 0, ELEMENT_TYPE__ld_ofs
VAR ELEMENT_TYPE__u_ofs, Q
	LA	 0, STANDARD.GRMR_TBL._GRMR_TBL_RECORD.use__info
	SA	 0, ELEMENT_TYPE__u_ofs
VAR GFP_disp, Q				; Lieu du Generic Frame Pointer 
					; CODE_PACKAGE_SPEC
 hexa_show ' spec ', $
; EXPANDER.DECLARATIONS.CODE_TYPE_DECL : skip PRIVATE FILE_TYPE (deferred to full type)

					; _FILE_MODE ENUMERATION TYPE INFO
_FILE_MODE = '_FILE_MODE'
namespace _FILE_MODE
VAR use__info, Q
BEGIN_BLOC_DEF
db 0, 7, "IN_FILE"
db 1, 8, "OUT_FILE"
END_BLOC_DEF 8, 0, 1
	; SIZ en bits !
	LCA	SIZ
	SA	0, use__info
end namespace
					; sub program entry decl (in instantiation TRUE )
if defined CREATE_L1_
PRO	CREATE_L1				;---------- PRO CREATE
 hexa_show 'CREATE_L1 ', $
PRMS					;    debut parametrage
	PRM FILE_ofs				; in out
	PRM MODE_ofs				; in
	PRM NAME_ofs				; in
	PRM FORM_ofs				; in
endPRMS					;    fin parametrage
ELB 1
begin:
	LVA	 0, GFP_disp
	LA 	 1, -FORM_ofs
	LA 	 1, -NAME_ofs
	LB	 1, -MODE_ofs
	LA 	 1, -FILE_ofs
	CALL	STANDARD.SEQUENTIAL_IO. ,CREATE_L1
	UNLINK	 1
	RTD	prm_siz
endPRO					;---------- end PRO CREATE
end if
					; sub program entry decl (in instantiation TRUE )
