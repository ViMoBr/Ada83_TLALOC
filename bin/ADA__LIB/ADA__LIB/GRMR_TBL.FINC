					; CODE_PACKAGE_SPEC
 hexa_show ' spec ', $

					; _AC_BYTE TYPE RANGE INFO
_AC_BYTE = '_AC_BYTE'
namespace _AC_BYTE
VAR use__info, Q
VAR SIZ__, D
	LVA	0, SIZ__
	SA	0, use__info
VAR FST, B
VAR LST, B
	LI	8
	SD	0, SIZ__
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	0
	SB	0, FST
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	255
	SB	0, LST
end namespace

					; _AC_SHORT TYPE RANGE INFO
_AC_SHORT = '_AC_SHORT'
namespace _AC_SHORT
VAR use__info, Q
VAR SIZ__, D
	LVA	0, SIZ__
	SA	0, use__info
VAR FST, W
VAR LST, W
	LI	16
	SD	0, SIZ__
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	00032768
	NEG
	SW	0, FST
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	32767
	SW	0, LST
end namespace

					; array decl constrained array type info
_ST_TBL_TYPE = '_ST_TBL_TYPE'
namespace _ST_TBL_TYPE
VAR use__info, Q
VAR SIZ__, D
	LVA	0, SIZ__
	SA	0, use__info
VAR _COMP_SIZ, D
VAR _FST_1, D
VAR _LST_1, D
	LI	32
	SD	0, _COMP_SIZ
	LD	0, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SD	0, _FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1000
	SD	0, _LST_1
	LD	0, _LST_1
	LD	0, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	SD	0, SIZ__
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace

