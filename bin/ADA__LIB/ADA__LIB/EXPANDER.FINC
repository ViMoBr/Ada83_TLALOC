namespace _HANDLER_CTX_AT__type		; array var constrained array type info
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
VAR _COMP_SIZ, D
VAR _FST_1, D
VAR _LST_1, D
	LI	8
	SD	1, _COMP_SIZ
	LD	1, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	SD	1, _FST_1
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	2
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	5
	DEC
	SHL
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	1
	SUB
	SD	1, _LST_1
	LD	1, _LST_1
	LD	1, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	SD	1, SIZ__
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR HANDLER_CTX_AT_disp, Q			; variable array : pointeur aux data
VAR HANDLER_CTX_AT__u, Q			; variable array : useinfo pointeur au rec info
	LA 1, _HANDLER_CTX_AT__type.use__info
	SA	1, HANDLER_CTX_AT__u			; array info ptr at __u
	LD	1, _HANDLER_CTX_AT__type.SIZ__
	LI	8
	DIV
