LOOP__2:
	LI	0					; lieu resultat sur pile
	LVA 3,	COMPLTN_UNIT_SEQ_disp
	CALL	STANDARD.IDL. ,IS_EMPTY_L23
	LI	1
	OUX
	BF	L162
	LVA  3,	STANDARD.EXPANDER_L1.CODE_ROOT_L37.BLOCK__1.COMPLTN_UNIT_disp
	LVA  3,	STANDARD.EXPANDER_L1.CODE_ROOT_L37.BLOCK__1.COMPLTN_UNIT_SEQ_disp
	CALL	STANDARD.IDL. ,POP_L24
; CODE & concat _STRING
VAR	ANON_427_32_L163_G_data, Q
VAR	ANON_427_32_L163_G_info, Q
VAR	ANON_427_49_L163_D_data, Q
VAR	ANON_427_49_L163_D_info, Q
VAR	ANON_427_32_L163_G_len,  Q
VAR	ANON_427_49_L163_D_len,  Q
VAR	ANON_427_32_L163_R_disp, Q
VAR	ANON_427_32_L163_R__u,   Q
namespace ANON_427_32_L163_R_info
  VAR SIZ__, D
  VAR _COMP_SIZ, D
  VAR _FST_1, D
  VAR _LST_1, D
end namespace
VAR	ANON_427_32_disp, Q
VAR	ANON_427_32__u,   Q
namespace ANON_427_32_info
  VAR SIZ__, D
  VAR _COMP_SIZ, D
  VAR _FST_1, D
  VAR _LST_1, D
end namespace
	LVA 3, ANON_427_32_info.SIZ__
	SA  3, ANON_427_32__u
	LVA 3, ANON_427_32_disp
	CALL	STANDARD.IDL. ,GET_LIB_PREFIX_L29
	DUP
	LA  ,  0
	SA  3, ANON_427_32_L163_G_data
	LA  ,  8
	SA  3, ANON_427_32_L163_G_info
	LID 3, ANON_427_32_L163_G_info, _STRING.LST_1
	LID 3, ANON_427_32_L163_G_info, _STRING.FST_1
	SUB
	INC
	CLAMP0
	SA  3, ANON_427_32_L163_G_len
VAR	ANON_427_49_disp, Q
VAR	ANON_427_49__u,   Q
namespace ANON_427_49_info
  VAR SIZ__, D
  VAR _COMP_SIZ, D
  VAR _FST_1, D
  VAR _LST_1, D
end namespace
	LVA 3, ANON_427_49_info.SIZ__
	SA  3, ANON_427_49__u
	LVA 3, ANON_427_49_disp
VAR	ANON_427_61_disp, Q
VAR	ANON_427_61__u,    Q
VAR	ANON_427_61__dat, STANDARD.IDL._TREE.size
	LVA 3, ANON_427_61__dat
	SA  3, ANON_427_61_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  3, ANON_427_61__u
	LVA 3, ANON_427_61_disp
					; doublet resultat record anonyme
	LVA 3,	COMPLTN_UNIT_disp
	LI  143
	CALL	STANDARD.IDL. ,D_L17
	CALL	STANDARD.IDL. ,PRINT_NAME_L25
	DUP
	LA  ,  0
	SA  3, ANON_427_49_L163_D_data
	LA  ,  8
	SA  3, ANON_427_49_L163_D_info
	LID 3, ANON_427_49_L163_D_info, _STRING.LST_1
	LID 3, ANON_427_49_L163_D_info, _STRING.FST_1
	SUB
	INC
	CLAMP0
	SA  3, ANON_427_49_L163_D_len
	LA  3, ANON_427_32_L163_G_len
	LA  3, ANON_427_49_L163_D_len
	ADD
	CO_VAR
	SA  3, ANON_427_32_L163_R_disp
	LI	1
	SD  3, ANON_427_32_L163_R_info._FST_1
	LA  3, ANON_427_32_L163_G_len
	LA  3, ANON_427_49_L163_D_len
	ADD
	SD  3, ANON_427_32_L163_R_info._LST_1
	LI	8
	SD  3, ANON_427_32_L163_R_info._COMP_SIZ
	LA  3, ANON_427_32_L163_G_len
	LA  3, ANON_427_49_L163_D_len
	ADD
	LI	8
	MUL
	SD  3, ANON_427_32_L163_R_info.SIZ__
	LVA 3, ANON_427_32_L163_R_info.SIZ__
	SA  3, ANON_427_32_L163_R__u
	LA  3, ANON_427_32_L163_R_disp
	LA  3, ANON_427_32_L163_G_len
	LA  3, ANON_427_32_L163_G_data
	BLKMOV
	LA  3, ANON_427_32_L163_R_disp
	LA  3, ANON_427_32_L163_G_len
	ADD
	LA  3, ANON_427_49_L163_D_len
	LA  3, ANON_427_49_L163_D_data
	BLKMOV
	LVA 3, ANON_427_32_L163_R_disp
	CALL	STANDARD.EXPANDER_L1.UTILS. ,OPEN_OUTPUT_FILE_L7
	LVA 3,	COMPLTN_UNIT_disp
	CALL	STANDARD.EXPANDER_L1.STRUCTURES. ,CODE_COMPILATION_UNIT_L149
	CALL	STANDARD.EXPANDER_L1.UTILS. ,CLOSE_OUTPUT_FILE_L8
	BRA	LOOP__2
L162:					; post loop LOOP__2
