					; _GOTO_LBL_REC RECORD TYPE INFO
_GOTO_LBL_REC = '_GOTO_LBL_REC'
namespace _GOTO_LBL_REC
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
USEINFO 1, ID, 	LA 0, STANDARD.IDL._TREE.use__info
USEINFO 1, LBL, 	LA 1, STANDARD.EXPANDER_L1.UTILS._LABEL_TYPE.use__info
USEINFO 1, DEFINED, 	LA 0, STANDARD._BOOLEAN.use__info
USEINFO 1, LEVEL, 	LA 1, STANDARD.EXPANDER_L1.UTILS._LEVEL_NUM.use__info
virtual at 0				; calcul des offsets statiques
STATOFS ID, 4, 8
STATOFS LBL, 4, 4
STATOFS DEFINED, 1, 1
STATOFS LEVEL, 4, 4
size = $
end virtual
	LI	 size*8
	SD	1, SIZ__
end namespace
