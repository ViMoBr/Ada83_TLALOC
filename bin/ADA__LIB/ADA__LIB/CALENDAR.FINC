elab_spec:				;    SPEC ELAB

					; CODE_PACKAGE_SPEC
 hexa_show ' spec ', $
; EXPANDER.DECLARATIONS.CODE_TYPE_DECL : skip PRIVATE TIME (deferred to full type)

					; _YEAR_NUMBER INTEGER SUBTYPE INFO
_YEAR_NUMBER = '_YEAR_NUMBER'
namespace _YEAR_NUMBER
VAR use__info, Q
VAR SIZ__, D
	LVA	0, SIZ__
	SA	0, use__info
VAR FST, D
VAR LST, D
	LI	32
	SD	0, SIZ__
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1901
	SD	0, FST
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2099
	SD	0, LST
VAR PARENT__u, Q
	LA	0, STANDARD._INTEGER.use__info
	SA	0, PARENT__u
end namespace

					; _MONTH_NUMBER INTEGER SUBTYPE INFO
_MONTH_NUMBER = '_MONTH_NUMBER'
namespace _MONTH_NUMBER
VAR use__info, Q
VAR SIZ__, D
	LVA	0, SIZ__
	SA	0, use__info
VAR FST, D
VAR LST, D
	LI	32
	SD	0, SIZ__
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SD	0, FST
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	12
	SD	0, LST
VAR PARENT__u, Q
	LA	0, STANDARD._INTEGER.use__info
	SA	0, PARENT__u
end namespace

					; _DAY_NUMBER INTEGER SUBTYPE INFO
_DAY_NUMBER = '_DAY_NUMBER'
namespace _DAY_NUMBER
VAR use__info, Q
VAR SIZ__, D
	LVA	0, SIZ__
	SA	0, use__info
VAR FST, D
VAR LST, D
	LI	32
	SD	0, SIZ__
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SD	0, FST
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	31
	SD	0, LST
VAR PARENT__u, Q
	LA	0, STANDARD._INTEGER.use__info
	SA	0, PARENT__u
end namespace

					; _DAY_DURATION FIXED SUBTYPE INFO
_DAY_DURATION = '_DAY_DURATION'
namespace _DAY_DURATION
VAR use__info, Q
VAR SIZ__, D
	LVA	0, SIZ__
	SA	0, use__info
	LI	64
	SD	0, SIZ__
VAR FST, Q
VAR LST, Q
	LI	 0
	LI	000536870912
	LI	 1
	CVTIX
	SQ	0, FST
	LI	00086400
	LI	000536870912
	LI	 1
	CVTIX
	SQ	0, LST
VAR NUMER, Q
VAR DENOM, Q
	LI	 1
	SQ	0, NUMER
	LI	000536870912
	SQ	0, DENOM
end namespace
