	LD
	LI	24
	LI	8
	UBFX
	CGE
	ET
	BF	L4
	LA  2,	-EXP_ofs
	CALL	STANDARD.EXPANDER_L1.EXPRESSIONS. ,CODE_NAME_L57
	BRA	L3
L4:
	LA 2, -EXP_ofs
	LA	-1, 0
	LD
	LI	24
	LI	8
	UBFX
	ULB	0, STANDARD.DIANA_NODE_ATTR_CLASS_NAMES._CLASS_EXP_EXP.FST
	CGE
	ULB	0, STANDARD.DIANA_NODE_ATTR_CLASS_NAMES._CLASS_EXP_EXP.LST
	LA 2, -EXP_ofs
	LA	-1, 0
	LD
	LI	24
	LI	8
	UBFX
	CGE
	ET
	BF	L5
	LVA  0,	STANDARD.IDL.TREE_VOID_disp		; array actual
	LA  2,	-EXP_ofs
	CALL	STANDARD.EXPANDER_L1.EXPRESSIONS. ,CODE_EXP_EXP_L58
	BRA	L3
L5:
	LA  2,	-EXP_ofs
