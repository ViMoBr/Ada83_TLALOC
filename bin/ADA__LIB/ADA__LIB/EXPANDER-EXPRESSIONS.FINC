	LA  0, STANDARD.IDL._TREE.use__info
	SA  4, ANON_6529_25__u
	LVA 4, ANON_6529_25_disp
					; doublet resultat record anonyme
	LVA 2,	STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_CONVERSION_L72.TARGET_TYPE_disp
	LI  35
	CALL	STANDARD.IDL. ,D_L17
	LA
	BLKMOV

 hexa_show ' disp ', TYPE_NAME_disp
 hexa_show 'var elab TARGET_TYPE_STR ', $
VAR TARGET_TYPE_STR_disp, Q			; variable array : pointeur aux data
VAR TARGET_TYPE_STR__u, Q			; variable array : useinfo pointeur au rec info
	LA 0, STANDARD._STRING.use__info
