 hexa_show 'var elab TYPE_NAME ', $
VAR TYPE_NAME_disp, Q			; variable record : pointeur aux data record
VAR TYPE_NAME__u, Q				; variable record : pointeur aux useinfo
VAR TYPE_NAME__dat, STANDARD.IDL._TREE.size
