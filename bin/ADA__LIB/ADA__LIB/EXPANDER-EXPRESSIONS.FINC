if defined CODE_EXP_L41_
PRO	CODE_EXP_L41				;---------- PRO CODE_EXP
 hexa_show 'CODE_EXP_L41 ', $
PRMS					;    debut parametrage
	PRM EXP_ofs				; in
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	LA 2, -EXP_ofs
	LA	-1, 0
	LD
	LI	24
	LI	8
	UBFX
	ULB	0, STANDARD.DIANA_NODE_ATTR_CLASS_NAMES._CLASS_NAME.FST
	CGE
	ULB	0, STANDARD.DIANA_NODE_ATTR_CLASS_NAMES._CLASS_NAME.LST
