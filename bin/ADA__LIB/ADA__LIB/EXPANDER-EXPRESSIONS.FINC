if defined CODE_ARRAY_AGGREGATE_OPERAND_L2230_
PRO	CODE_ARRAY_AGGREGATE_OPERAND_L2230		;---------- PRO CODE_ARRAY_AGGREGATE_OPERAND
 hexa_show 'CODE_ARRAY_AGGREGATE_OPERAND_L2230 ', $
PRMS					;    debut parametrage
	PRM AGG_ofs				; in
	PRM ANON_ofs				; in
	PRM CONTEXT_TYPE_ofs			; in
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
 hexa_show 'var elab COMP_TYPE ', $
VAR COMP_TYPE_disp, Q			; variable record : pointeur aux data record
VAR COMP_TYPE__u, Q				; variable record : pointeur aux useinfo
VAR COMP_TYPE__dat, STANDARD.IDL._TREE.size
	LVA	2, COMP_TYPE__dat
	SA	2, COMP_TYPE_disp			; record fin
	LVA	2, STANDARD.IDL._TREE.SIZ__
	SA	2, COMP_TYPE__u
	LA  2, COMP_TYPE_disp
	LI	STANDARD.IDL._TREE.size
VAR	ANON_3572_25_disp, Q
