if defined CODE_VC_ID_L76_
PRO	CODE_VC_ID_L76				;---------- PRO CODE_VC_ID
 hexa_show 'CODE_VC_ID_L76 ', $
PRMS					;    debut parametrage
	PRM VC_ID_ofs				; in
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
 hexa_show 'var elab VC_TYPE ', $
VAR VC_TYPE_disp, Q				; variable record : pointeur aux data record
VAR VC_TYPE__u, Q				; variable record : pointeur aux useinfo
VAR VC_TYPE__dat, STANDARD.IDL._TREE.size
	LVA	2, VC_TYPE__dat
	SA	2, VC_TYPE_disp				; record fin
	LVA	2, STANDARD.IDL._TREE.SIZ__
	SA	2, VC_TYPE__u
	LA  2, VC_TYPE_disp
	LI	STANDARD.IDL._TREE.size
VAR	ANON_7034_24_disp, Q
VAR	ANON_7034_24__u,    Q
VAR	ANON_7034_24__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_7034_24__dat
	SA  2, ANON_7034_24_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_7034_24__u
	LVA 2, ANON_7034_24_disp
					; doublet resultat record anonyme
	LA  2,	-VC_ID_ofs
	LI  15
	CALL	STANDARD.IDL. ,D_L17
	LA
	BLKMOV

 hexa_show ' disp ', VC_TYPE_disp
 hexa_show 'var elab VC_LEVEL ', $
VAR VC_LEVEL_disp, D			; variable entiere
	LI	0					; lieu resultat sur pile
	LA  2,	-VC_ID_ofs
	LI  28
	CALL	STANDARD.IDL. ,DI_L21
	DUP
	LD	1, STANDARD.EXPANDER_L1.UTILS._LEVEL_NUM.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	1, STANDARD.EXPANDER_L1.UTILS._LEVEL_NUM.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  2,	VC_LEVEL_disp

 hexa_show ' disp ', VC_LEVEL_disp
 hexa_show 'var elab VC_STR ', $
VAR VC_STR_disp, Q				; variable array : pointeur aux data
VAR VC_STR__u, Q				; variable array : useinfo pointeur au rec info
	LA 0, STANDARD._STRING.use__info
	SA	2, VC_STR__u				; array info ptr at __u
