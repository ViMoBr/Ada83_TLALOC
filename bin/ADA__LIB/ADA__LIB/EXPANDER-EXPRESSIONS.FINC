PRO	EMIT_AGG_AT_DEPTH_L3830			;---------- PRO EMIT_AGG_AT_DEPTH
 hexa_show 'EMIT_AGG_AT_DEPTH_L3830 ', $
PRMS					;    debut parametrage
	PRM AGG_ofs				; in
	PRM DEPTH_ofs				; in
endPRMS					;    fin parametrage
ELB 3					;    BODY ELAB
 hexa_show 'var elab SEQ ', $
VAR SEQ_disp, Q				; variable record : pointeur aux data record
VAR SEQ__u, Q				; variable record : pointeur aux useinfo
VAR SEQ__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA	3, SEQ__dat
	SA	3, SEQ_disp				; record fin
	LVA	3, STANDARD.IDL._SEQ_TYPE.SIZ__
	SA	3, SEQ__u
	LA  3, SEQ_disp
	LI	STANDARD.IDL._SEQ_TYPE.size
VAR	ANON_5461_25_disp, Q
VAR	ANON_5461_25__u,    Q
VAR	ANON_5461_25__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA 3, ANON_5461_25__dat
	SA  3, ANON_5461_25_disp
	LA  0, STANDARD.IDL._SEQ_TYPE.use__info
	SA  3, ANON_5461_25__u
	LVA 3, ANON_5461_25_disp
					; doublet resultat record anonyme
VAR	ANON_5461_31_disp, Q
VAR	ANON_5461_31__u,    Q
VAR	ANON_5461_31__dat, STANDARD.IDL._TREE.size
	LVA 3, ANON_5461_31__dat
	SA  3, ANON_5461_31_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  3, ANON_5461_31__u
	LVA 3, ANON_5461_31_disp
					; doublet resultat record anonyme
	LA  3,	-AGG_ofs
	LI  92
	CALL	STANDARD.IDL. ,D_L17
	CALL	STANDARD.IDL. ,LIST_L22
	LA
	BLKMOV

 hexa_show ' disp ', SEQ_disp
 hexa_show 'var elab ASSOC ', $
VAR ASSOC_disp, Q				; variable record : pointeur aux data record
VAR ASSOC__u, Q				; variable record : pointeur aux useinfo
VAR ASSOC__dat, STANDARD.IDL._TREE.size
	LVA	3, ASSOC__dat
	SA	3, ASSOC_disp				; record fin
	LVA	3, STANDARD.IDL._TREE.SIZ__
	SA	3, ASSOC__u
	LA  3, ASSOC_disp
					; store represented component PT range 0 .. 1 width 2
	DUP
	LD
	LI	0
	LI	0
	LI	2
	BFI
	SD

 hexa_show ' disp ', ASSOC_disp
					;    end elab
