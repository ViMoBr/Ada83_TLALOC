					; debut if
; CODE record equality "=" _TREE
	LA  3,	-RNG_ofs
	LA
	LD
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	LA
	LD
	CEQ
	BF	L3665
STR STR_L3666, "; CODE_ARRAY_AGGREGATE : range de dimension absente"	; constante string="; CODE_ARRAY_AGGREGATE : range de dimension absente"
	LCA	STR_L3666.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LCA	STANDARD.PROGRAM_ERROR__exc.data_ptr
	SA	0, STANDARD.EXCEPTIONS_CURRENT_disp
	BRA	STANDARD.exc_raise_
	BRA	L3664
L3665:
L3664:					; post if
					; debut if
	LD 2,	STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L3615.NB_DIMS_disp
	LD 2,	STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L3615.MAX_DIMS_disp
	CEQ
