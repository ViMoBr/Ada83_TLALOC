					; doublet resultat record anonyme
	LA  3,	-RNG_ofs
	LI  51
	CALL	STANDARD.IDL. ,D_L17
	LA
	BLKMOV
	LA	 2, STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L3615.DIM_TBL_disp	; array data start address on stack
	LD 2,	STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L3615.NB_DIMS_disp
	DUP
	LID	2, STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L3615.DIM_TBL__u, STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L3615._DIM_TBL__type.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LID	2, STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L3615.DIM_TBL__u, STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L3615._DIM_TBL__type.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LID	2, STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L3615.DIM_TBL__u, STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L3615._DIM_TBL__type.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LID	2, STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L3615.DIM_TBL__u, STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L3615._DIM_TBL__type.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LVA	, STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L3615._DIM_INFO.FST_EXP
	LI	STANDARD.IDL._TREE.size
	LVA 3,	FST_disp
	LA
