VAR LST__u, Q				; variable record : pointeur aux useinfo
VAR LST__dat, STANDARD.IDL._TREE.size
	LVA	3, LST__dat
	SA	3, LST_disp				; record fin
	LVA	3, STANDARD.IDL._TREE.SIZ__
	SA	3, LST__u
