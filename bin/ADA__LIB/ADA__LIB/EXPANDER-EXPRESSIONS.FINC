	LCA	STR_L3669.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LCA	STANDARD.PROGRAM_ERROR__exc.data_ptr
	SA	0, STANDARD.EXCEPTIONS_CURRENT_disp
	BRA	STANDARD.exc_raise_
	BRA	L3667
L3668:
L3667:					; post if
	LD 2,	STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L3615.NB_DIMS_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	DUP
	LD	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD._NATURAL.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  2,	STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L3615.NB_DIMS_disp
	LVA 3,	FST_disp
	LA
	LI	STANDARD.IDL._TREE.size
VAR	ANON_5061_14_disp, Q
VAR	ANON_5061_14__u,    Q
VAR	ANON_5061_14__dat, STANDARD.IDL._TREE.size
