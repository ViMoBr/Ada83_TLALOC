					; doublet resultat record anonyme
	LA  2,	-ATTRIBUTE_ofs
	LI  48
	CALL	STANDARD.IDL. ,D_L17
	LA
	BLKMOV

 hexa_show ' disp ', PREFIX_disp
 hexa_show 'var elab PREFIX_TYPE ', $
VAR PREFIX_TYPE_disp, Q			; variable record : pointeur aux data record
VAR PREFIX_TYPE__u, Q			; variable record : pointeur aux useinfo
VAR PREFIX_TYPE__dat, STANDARD.IDL._TREE.size
	LVA	2, PREFIX_TYPE__dat
	SA	2, PREFIX_TYPE_disp			; record fin
	LVA	2, STANDARD.IDL._TREE.SIZ__
	SA	2, PREFIX_TYPE__u
	LA  2, PREFIX_TYPE_disp
	LI	STANDARD.IDL._TREE.size
VAR	ANON_68_28_disp, Q
VAR	ANON_68_28__u,    Q
VAR	ANON_68_28__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_68_28__dat
	SA  2, ANON_68_28_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_68_28__u
	LVA 2, ANON_68_28_disp
					; doublet resultat record anonyme
	LVA 2,	PREFIX_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.EXP_TYPE. ,EVAL_TYPE_MARK_L217
	LA
	BLKMOV

 hexa_show ' disp ', PREFIX_TYPE_disp
 hexa_show 'var elab TYPESET ', $
VAR TYPESET_disp, Q				; variable record : pointeur aux data record
VAR TYPESET__u, Q				; variable record : pointeur aux useinfo
VAR TYPESET__dat, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._TYPESET_TYPE.size
	LVA	2, TYPESET__dat
	SA	2, TYPESET_disp				; record fin
	LVA	2, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._TYPESET_TYPE.SIZ__
	SA	2, TYPESET__u

 hexa_show ' disp ', TYPESET_disp
 hexa_show 'var elab STATIC_VALUE ', $
VAR STATIC_VALUE_disp, Q			; variable record : pointeur aux data record
VAR STATIC_VALUE__u, Q			; variable record : pointeur aux useinfo
VAR STATIC_VALUE__dat, STANDARD.IDL._TREE.size
	LVA	2, STATIC_VALUE__dat
	SA	2, STATIC_VALUE_disp			; record fin
	LVA	2, STANDARD.IDL._TREE.SIZ__
	SA	2, STATIC_VALUE__u
	LA  2, STATIC_VALUE_disp
	LI	STANDARD.IDL._TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	LA
	BLKMOV

 hexa_show ' disp ', STATIC_VALUE_disp
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LVA 2,	ATTRIBUTE_ID_disp
	LA
	LI	STANDARD.IDL._TREE.size
VAR	ANON_73_21_disp, Q
VAR	ANON_73_21__u,    Q
VAR	ANON_73_21__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_73_21__dat
	SA  2, ANON_73_21_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_73_21__u
	LVA 2, ANON_73_21_disp
					; doublet resultat record anonyme
	LA  2,	-ATTRIBUTE_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.ATT_WALK. ,EVAL_ATTRIBUTE_IDENTIFIER_L198
	LA
	BLKMOV
	LVA 2,	PREFIX_disp
	LA
	LI	STANDARD.IDL._TREE.size
VAR	ANON_74_21_disp, Q
VAR	ANON_74_21__u,    Q
VAR	ANON_74_21__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_74_21__dat
	SA  2, ANON_74_21_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_74_21__u
	LVA 2, ANON_74_21_disp
					; doublet resultat record anonyme
	LVA 2,	PREFIX_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.EXPRESO. ,RESOLVE_TYPE_MARK_L160
	LA
	BLKMOV
	LVA 2,	PREFIX_disp
	LA  2,	-ATTRIBUTE_ofs
	LI  48
	CALL	STANDARD.IDL. ,D_L16
	LVA  0,	STANDARD.IDL.TREE_VOID_disp		; array actual
	LA  2,	-ATTRIBUTE_ofs
	LI  87
	CALL	STANDARD.IDL. ,D_L16
	LVA  2,	STANDARD.IDL.SEM_PHASE_L11.REP_CLAU.RESOLVE_LENGTH_REP_L496.TYPESET_disp
	LA  2,	-EXP_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.EXP_TYPE. ,EVAL_EXP_TYPES_L215
					; debut if
; CODE record equality "/=" _TREE
	LVA 2,	ATTRIBUTE_ID_disp
	LA
	LD
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	LA
	LD
	CEQ
	LI	1
	OUX
	BF	L22
					; debut case
	LI	0					; lieu resultat sur pile
	LVA 2,	ATTRIBUTE_ID_disp
	LI  151
	CALL	STANDARD.IDL. ,DI_L21
	DUP
	LI	32
	CEQ
	BT	L24
	DUP
	LI	34
	CEQ
	BT	L25
	DUP
	LI	33
	CEQ
	BT	L26
	DROP
	BRA	L27
L24:
	DROP
	LVA  2,	STANDARD.IDL.SEM_PHASE_L11.REP_CLAU.RESOLVE_LENGTH_REP_L496.TYPESET_disp
	LA  2,	-EXP_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.REQ_UTIL. ,REQUIRE_INTEGER_TYPE_L134
	LVA  2,	STANDARD.IDL.SEM_PHASE_L11.REP_CLAU.RESOLVE_LENGTH_REP_L496.TYPESET_disp
	LA  2,	-EXP_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,REQUIRE_UNIQUE_TYPE_L100
	LA  2,	-EXP_ofs
	LA
	LI	STANDARD.IDL._TREE.size
VAR	ANON_85_16_disp, Q
VAR	ANON_85_16__u,    Q
VAR	ANON_85_16__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_85_16__dat
	SA  2, ANON_85_16_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_85_16__u
	LVA 2, ANON_85_16_disp
					; doublet resultat record anonyme
	LVA 2,	TYPESET_disp
	LA  2,	-EXP_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.EXPRESO. ,RESOLVE_EXP_L162
	LA
	BLKMOV
					; debut if
	LI	0					; lieu resultat sur pile
	LVA 2,	TYPESET_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,IS_EMPTY_L88
	LI	1
	OUX
	BF	L29
	LVA 2,	STATIC_VALUE_disp
	LA
	LI	STANDARD.IDL._TREE.size
VAR	ANON_88_18_disp, Q
VAR	ANON_88_18__u,    Q
VAR	ANON_88_18__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_88_18__dat
	SA  2, ANON_88_18_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_88_18__u
	LVA 2, ANON_88_18_disp
					; doublet resultat record anonyme
	LA  2,	-EXP_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.EXPRESO. ,GET_STATIC_VALUE_L157
	LA
	BLKMOV
					; debut if
; CODE record equality "=" _TREE
	LVA 2,	STATIC_VALUE_disp
	LA
	LD
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	LA
	LD
	CEQ
	BF	L31
STR STR_L32, "STATIC EXPRESSION REQUIRED"	; constante string="STATIC EXPRESSION REQUIRED"
	LCA	STR_L32.data_ptr
VAR	ANON_90_11_disp, Q
VAR	ANON_90_11__u,    Q
VAR	ANON_90_11__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_90_11__dat
	SA  2, ANON_90_11_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_90_11__u
	LVA 2, ANON_90_11_disp
					; doublet resultat record anonyme
	LA  2,	-EXP_ofs
	LI  154
	CALL	STANDARD.IDL. ,D_L17
	CALL	STANDARD.IDL.IDL_MAN. ,ERROR_L45
	BRA	L30
L31:
L30:					; post if
	BRA	L28
L29:
L28:					; post if
					; debut if
	LA	2, STANDARD.IDL.SEM_PHASE_L11.REP_CLAU.RESOLVE_LENGTH_REP_L496.PREFIX_TYPE_disp
	LD
	LI	24
	LI	8
	UBFX
	ULB	0, STANDARD.DIANA_NODE_ATTR_CLASS_NAMES._CLASS_SCALAR.FST
	CGE
	ULB	0, STANDARD.DIANA_NODE_ATTR_CLASS_NAMES._CLASS_SCALAR.LST
	LA	2, STANDARD.IDL.SEM_PHASE_L11.REP_CLAU.RESOLVE_LENGTH_REP_L496.PREFIX_TYPE_disp
	LD
	LI	24
	LI	8
	UBFX
	CGE
	ET
	BF	L34
	LVA 2,	STATIC_VALUE_disp
	LVA 2,	PREFIX_TYPE_disp
	LI  40
	CALL	STANDARD.IDL. ,D_L16
	LVA 2,	STATIC_VALUE_disp
VAR	ANON_97_19_disp, Q
VAR	ANON_97_19__u,    Q
VAR	ANON_97_19__dat, STANDARD.IDL._TREE.size
