REP_CLAU = 'REP_CLAU'
namespace REP_CLAU				;---------- PACKAGE (BDY)
					;    BODY ELAB

if defined REQUIRE_CURRENT_REGION_L1_
PRO	REQUIRE_CURRENT_REGION_L1			;---------- PRO REQUIRE_CURRENT_REGION
 hexa_show 'REQUIRE_CURRENT_REGION_L1 ', $
PRMS					;    debut parametrage
	PRM NAME_ofs				; in
	PRM DEFSET_ofs				; in out
	PRM H_ofs				; in
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
 hexa_show 'var elab TEMP_DEFSET ', $
VAR TEMP_DEFSET_disp, Q			; variable record : pointeur aux data record
VAR TEMP_DEFSET__u, Q			; variable record : pointeur aux useinfo
VAR TEMP_DEFSET__dat, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._DEFSET_TYPE.size
	LVA	2, TEMP_DEFSET__dat
	SA	2, TEMP_DEFSET_disp			; record fin
	LVA	2, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._DEFSET_TYPE.SIZ__
	SA	2, TEMP_DEFSET__u
	LA  2, TEMP_DEFSET_disp
	LI	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._DEFSET_TYPE.size
	LA  2,	-DEFSET_ofs
	LA
	BLKMOV

 hexa_show ' disp ', TEMP_DEFSET_disp
 hexa_show 'var elab TEMP_DEFINTERP ', $
VAR TEMP_DEFINTERP_disp, Q			; variable record : pointeur aux data record
VAR TEMP_DEFINTERP__u, Q			; variable record : pointeur aux useinfo
VAR TEMP_DEFINTERP__dat, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._DEFINTERP_TYPE.size
	LVA	2, TEMP_DEFINTERP__dat
	SA	2, TEMP_DEFINTERP_disp			; record fin
	LVA	2, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._DEFINTERP_TYPE.SIZ__
	SA	2, TEMP_DEFINTERP__u
	LA  2, TEMP_DEFINTERP_disp
					; store represented component PT range 0 .. 1 width 2
	DUP
	LD
	LI	0
	LI	0
	LI	2
	BFI
	SD

 hexa_show ' disp ', TEMP_DEFINTERP_disp
 hexa_show 'var elab TEMP_DEF ', $
VAR TEMP_DEF_disp, Q			; variable record : pointeur aux data record
VAR TEMP_DEF__u, Q				; variable record : pointeur aux useinfo
VAR TEMP_DEF__dat, STANDARD.IDL._TREE.size
	LVA	2, TEMP_DEF__dat
	SA	2, TEMP_DEF_disp			; record fin
	LVA	2, STANDARD.IDL._TREE.SIZ__
	SA	2, TEMP_DEF__u
	LA  2, TEMP_DEF_disp
					; store represented component PT range 0 .. 1 width 2
	DUP
	LD
	LI	0
	LI	0
	LI	2
	BFI
	SD

 hexa_show ' disp ', TEMP_DEF_disp
 hexa_show 'var elab SOURCE_NAME ', $
VAR SOURCE_NAME_disp, Q			; variable record : pointeur aux data record
VAR SOURCE_NAME__u, Q			; variable record : pointeur aux useinfo
VAR SOURCE_NAME__dat, STANDARD.IDL._TREE.size
	LVA	2, SOURCE_NAME__dat
	SA	2, SOURCE_NAME_disp			; record fin
	LVA	2, STANDARD.IDL._TREE.SIZ__
	SA	2, SOURCE_NAME__u
	LA  2, SOURCE_NAME_disp
					; store represented component PT range 0 .. 1 width 2
	DUP
	LD
	LI	0
	LI	0
	LI	2
	BFI
	SD

 hexa_show ' disp ', SOURCE_NAME_disp
 hexa_show 'var elab UNIT_DESC ', $
VAR UNIT_DESC_disp, Q			; variable record : pointeur aux data record
VAR UNIT_DESC__u, Q				; variable record : pointeur aux useinfo
VAR UNIT_DESC__dat, STANDARD.IDL._TREE.size
	LVA	2, UNIT_DESC__dat
	SA	2, UNIT_DESC_disp			; record fin
	LVA	2, STANDARD.IDL._TREE.SIZ__
	SA	2, UNIT_DESC__u
	LA  2, UNIT_DESC_disp
					; store represented component PT range 0 .. 1 width 2
	DUP
	LD
	LI	0
	LI	0
	LI	2
	BFI
	SD

 hexa_show ' disp ', UNIT_DESC_disp
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	LI	0					; lieu resultat sur pile
	LVA 2,	TEMP_DEFSET_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,IS_EMPTY_L74
	BF	L5
	BRA ret_lbl
	BRA	L4
L5:
L4:					; post if
	LA  2,	-DEFSET_ofs
	LA
	LI	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._DEFSET_TYPE.size
	LVA 1,	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.EMPTY_DEFSET_disp
	LA
	BLKMOV
LOOP__1:
	LI	0					; lieu resultat sur pile
	LVA 2,	TEMP_DEFSET_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,IS_EMPTY_L74
	LI	1
	OUX
	BF	L6
	LVA  2,	STANDARD.IDL.SEM_PHASE_L11.REP_CLAU.REQUIRE_CURRENT_REGION_L1.TEMP_DEFINTERP_disp
	LVA  2,	STANDARD.IDL.SEM_PHASE_L11.REP_CLAU.REQUIRE_CURRENT_REGION_L1.TEMP_DEFSET_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,POP_L75
	LVA 2,	TEMP_DEF_disp
	LA
	LI	STANDARD.IDL._TREE.size
VAR	ANON_38_19_disp, Q
VAR	ANON_38_19__u,    Q
VAR	ANON_38_19__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_38_19__dat
	SA  2, ANON_38_19_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_38_19__u
	LVA 2, ANON_38_19_disp
					; doublet resultat record anonyme
	LVA 2,	TEMP_DEFINTERP_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,GET_DEF_L82
	LA
	BLKMOV
					; debut if
; CODE record equality "=" _TREE
VAR	ANON_40_10_disp, Q
VAR	ANON_40_10__u,    Q
VAR	ANON_40_10__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_40_10__dat
	SA  2, ANON_40_10_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_40_10__u
	LVA 2, ANON_40_10_disp
					; doublet resultat record anonyme
	LVA 2,	TEMP_DEF_disp
	LI  169
	CALL	STANDARD.IDL. ,D_L17
	LA
	LD
	LA 2, -H_ofs
	LIVA 	, 0, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.REGION_DEF
	LD
	CEQ
	DUP
	BF	L9
	DROP
	LA 2, -H_ofs
	ULIB	, 0, STANDARD.IDL.SEM_PHASE_L11.SEM_GLOB._H_TYPE.IS_IN_BODY
	LI	0					; lieu resultat sur pile
	LVA 2,	TEMP_DEF_disp
	LI  170
	CALL	STANDARD.IDL. ,DB_L19
	ET
	LI	1
	OUX
L9:
	BF	L8
	LVA 2,	SOURCE_NAME_disp
	LA
	LI	STANDARD.IDL._TREE.size
VAR	ANON_42_24_disp, Q
VAR	ANON_42_24__u,    Q
VAR	ANON_42_24__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_42_24__dat
	SA  2, ANON_42_24_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_42_24__u
	LVA 2, ANON_42_24_disp
					; doublet resultat record anonyme
	LVA 2,	TEMP_DEF_disp
	LI  35
	CALL	STANDARD.IDL. ,D_L17
	LA
	BLKMOV
					; debut if
	LA	2, STANDARD.IDL.SEM_PHASE_L11.REP_CLAU.REQUIRE_CURRENT_REGION_L1.SOURCE_NAME_disp
	LD
	LI	24
	LI	8
	UBFX
	LI	40
	CEQ
	BF	L11
	BRA	L10
L11:
	LA	2, STANDARD.IDL.SEM_PHASE_L11.REP_CLAU.REQUIRE_CURRENT_REGION_L1.SOURCE_NAME_disp
	LD
	LI	24
	LI	8
	UBFX
	ULB	0, STANDARD.DIANA_NODE_ATTR_CLASS_NAMES._CLASS_SUBPROG_NAME.FST
	CGE
	ULB	0, STANDARD.DIANA_NODE_ATTR_CLASS_NAMES._CLASS_SUBPROG_NAME.LST
	LA	2, STANDARD.IDL.SEM_PHASE_L11.REP_CLAU.REQUIRE_CURRENT_REGION_L1.SOURCE_NAME_disp
	LD
	LI	24
	LI	8
	UBFX
	CGE
	ET
	BF	L12
	LVA 2,	UNIT_DESC_disp
	LA
	LI	STANDARD.IDL._TREE.size
VAR	ANON_46_15_disp, Q
VAR	ANON_46_15__u,    Q
VAR	ANON_46_15__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_46_15__dat
	SA  2, ANON_46_15_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_46_15__u
	LVA 2, ANON_46_15_disp
					; doublet resultat record anonyme
	LVA 2,	SOURCE_NAME_disp
	LI  112
	CALL	STANDARD.IDL. ,D_L17
	LA
	BLKMOV
					; debut if
	LA	2, STANDARD.IDL.SEM_PHASE_L11.REP_CLAU.REQUIRE_CURRENT_REGION_L1.UNIT_DESC_disp
	LD
	LI	24
	LI	8
	UBFX
	LI	168
	CNE
	DUP
	BF	L15
	DROP
	LA	2, STANDARD.IDL.SEM_PHASE_L11.REP_CLAU.REQUIRE_CURRENT_REGION_L1.UNIT_DESC_disp
	LD
	LI	24
	LI	8
	UBFX
	LI	175
	CGE
	LI	176
	LA	2, STANDARD.IDL.SEM_PHASE_L11.REP_CLAU.REQUIRE_CURRENT_REGION_L1.UNIT_DESC_disp
	LD
	LI	24
	LI	8
	UBFX
	CGE
	ET
	LI	1
	OUX
L15:
	BF	L14
	LVA 2,	TEMP_DEFINTERP_disp
	LA  2,	-DEFSET_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,ADD_TO_DEFSET_L80
	BRA	L13
L14:
L13:					; post if
	BRA	L10
L12:
	LVA 2,	TEMP_DEFINTERP_disp
	LA  2,	-DEFSET_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,ADD_TO_DEFSET_L80
L10:					; post if
	BRA	L7
L8:
L7:					; post if
	BRA	LOOP__1
L6:					; post loop LOOP__1
					; debut if
	LI	0					; lieu resultat sur pile
	LA  2,	-DEFSET_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,IS_EMPTY_L74
	BF	L17
STR STR_L18, "MUST BE IN CURRENT REGION"	; constante string="MUST BE IN CURRENT REGION"
	LCA	STR_L18.data_ptr
VAR	ANON_57_14_disp, Q
VAR	ANON_57_14__u,    Q
VAR	ANON_57_14__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_57_14__dat
	SA  2, ANON_57_14_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_57_14__u
	LVA 2, ANON_57_14_disp
					; doublet resultat record anonyme
	LA  2,	-NAME_ofs
	LI  154
	CALL	STANDARD.IDL. ,D_L17
	CALL	STANDARD.IDL.IDL_MAN. ,ERROR_L45
	BRA	L16
L17:
L16:					; post if
ret_lbl:
	UNLINK 2
	RTD	prm_siz
excep:
endPRO					;---------- end PRO REQUIRE_CURRENT_REGION
end if

if defined RESOLVE_LENGTH_REP_L496_
PRO	RESOLVE_LENGTH_REP_L496			;---------- PRO RESOLVE_LENGTH_REP
 hexa_show 'RESOLVE_LENGTH_REP_L496 ', $
PRMS					;    debut parametrage
	PRM ATTRIBUTE_ofs				; in
	PRM EXP_ofs				; in out
	PRM H_ofs				; in
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
 hexa_show 'var elab ATTRIBUTE_ID ', $
VAR ATTRIBUTE_ID_disp, Q			; variable record : pointeur aux data record
VAR ATTRIBUTE_ID__u, Q			; variable record : pointeur aux useinfo
VAR ATTRIBUTE_ID__dat, STANDARD.IDL._TREE.size
	LVA	2, ATTRIBUTE_ID__dat
	SA	2, ATTRIBUTE_ID_disp			; record fin
	LVA	2, STANDARD.IDL._TREE.SIZ__
	SA	2, ATTRIBUTE_ID__u
	LA  2, ATTRIBUTE_ID_disp
					; store represented component PT range 0 .. 1 width 2
	DUP
	LD
	LI	0
	LI	0
	LI	2
	BFI
	SD

 hexa_show ' disp ', ATTRIBUTE_ID_disp
 hexa_show 'var elab PREFIX ', $
VAR PREFIX_disp, Q				; variable record : pointeur aux data record
VAR PREFIX__u, Q				; variable record : pointeur aux useinfo
VAR PREFIX__dat, STANDARD.IDL._TREE.size
	LVA	2, PREFIX__dat
	SA	2, PREFIX_disp				; record fin
	LVA	2, STANDARD.IDL._TREE.SIZ__
	SA	2, PREFIX__u
	LA  2, PREFIX_disp
	LI	STANDARD.IDL._TREE.size
VAR	ANON_67_23_disp, Q
VAR	ANON_67_23__u,    Q
VAR	ANON_67_23__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_67_23__dat
	SA  2, ANON_67_23_disp
	LA  0, STANDARD.IDL._TREE.use__info
