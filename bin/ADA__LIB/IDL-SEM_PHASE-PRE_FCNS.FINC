if defined GEN_OP_DEF_L13_
PRO	GEN_OP_DEF_L13				;---------- PRO GEN_OP_DEF
 hexa_show 'GEN_OP_DEF_L13 ', $
PRMS					;    debut parametrage
	PRM OP_ofs				; in
	PRM HEADER_ofs				; in
	PRM H_ofs				; in
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
 hexa_show 'var elab DEF ', $
