VAR	ANON_86_31__u,    Q
VAR	ANON_86_31__dat, STANDARD.IDL._TREE.size
	LVA 3, ANON_86_31__dat
	SA  3, ANON_86_31_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  3, ANON_86_31__u
	LVA 3, ANON_86_31_disp
					; doublet resultat record anonyme
	LA	 1, STANDARD.IDL.SEM_PHASE_L11.PRENAME.BLTN_ID_ARRAY_disp	; array data start address on stack
	ULB 2,	OPL21_disp
	DUP
	LID	1, STANDARD.IDL.SEM_PHASE_L11.PRENAME.BLTN_ID_ARRAY__u, STANDARD.IDL.SEM_PHASE_L11.PRENAME._BLTN_ID_ARRAY__type.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LID	1, STANDARD.IDL.SEM_PHASE_L11.PRENAME.BLTN_ID_ARRAY__u, STANDARD.IDL.SEM_PHASE_L11.PRENAME._BLTN_ID_ARRAY__type.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LID	1, STANDARD.IDL.SEM_PHASE_L11.PRENAME.BLTN_ID_ARRAY__u, STANDARD.IDL.SEM_PHASE_L11.PRENAME._BLTN_ID_ARRAY__type.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LID	1, STANDARD.IDL.SEM_PHASE_L11.PRENAME.BLTN_ID_ARRAY__u, STANDARD.IDL.SEM_PHASE_L11.PRENAME._BLTN_ID_ARRAY__type.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
VAR	ANON_86_45_dbl_L24_disp, q
VAR	ANON_86_45_dbl_L24__u,   q
	SA  3, ANON_86_45_dbl_L24_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  3, ANON_86_45_dbl_L24__u
	LVA 3, ANON_86_45_dbl_L24_disp
	LI  13
	CALL	STANDARD.IDL. ,D_L17
	CALL	STANDARD.IDL. ,LIST_L22
	LA
	BLKMOV

 hexa_show ' disp ', DEFLIST_disp
 hexa_show 'var elab DEF ', $
