	DUP
	LD
	LI	0
	LI	0
	LI	2
	BFI
	SD

 hexa_show ' disp ', DEF_disp
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LVA 2,	DEF_disp
	LA
	LI	STANDARD.IDL._TREE.size
VAR	ANON_73_12_disp, Q
VAR	ANON_73_12__u,    Q
VAR	ANON_73_12__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_73_12__dat
	SA  2, ANON_73_12_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_73_12__u
	LVA 2, ANON_73_12_disp
					; doublet resultat record anonyme
	LA  2,	-H_ofs
	LA	 1, STANDARD.IDL.SEM_PHASE_L11.PRENAME.BLTN_ID_ARRAY_disp	; array data start address on stack
	ULB  2,	-OP_ofs
	DUP
	LID	1, STANDARD.IDL.SEM_PHASE_L11.PRENAME.BLTN_ID_ARRAY__u, STANDARD.IDL.SEM_PHASE_L11.PRENAME._BLTN_ID_ARRAY__type.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LID	1, STANDARD.IDL.SEM_PHASE_L11.PRENAME.BLTN_ID_ARRAY__u, STANDARD.IDL.SEM_PHASE_L11.PRENAME._BLTN_ID_ARRAY__type.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LID	1, STANDARD.IDL.SEM_PHASE_L11.PRENAME.BLTN_ID_ARRAY__u, STANDARD.IDL.SEM_PHASE_L11.PRENAME._BLTN_ID_ARRAY__type.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LID	1, STANDARD.IDL.SEM_PHASE_L11.PRENAME.BLTN_ID_ARRAY__u, STANDARD.IDL.SEM_PHASE_L11.PRENAME._BLTN_ID_ARRAY__type.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
VAR	ANON_73_29_dbl_L16_disp, q
VAR	ANON_73_29_dbl_L16__u,   q
	SA  2, ANON_73_29_dbl_L16_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_73_29_dbl_L16__u
	LVA 2, ANON_73_29_dbl_L16_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.DEF_UTIL. ,MAKE_DEF_FOR_ID_L52
	LA
	BLKMOV
	LA  2,	-HEADER_ofs
	LVA 2,	DEF_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.DEF_UTIL. ,MAKE_DEF_VISIBLE_L67
ret_lbl:
	UNLINKR 2
	RTD	prm_siz
excep:
endPRO					;---------- end PRO GEN_OP_DEF
end if

if defined OPS_ARE_NOT_YET_DEFINED_L17_
PRO	OPS_ARE_NOT_YET_DEFINED_L17		;---------- PRO OPS_ARE_NOT_YET_DEFINED
 hexa_show 'OPS_ARE_NOT_YET_DEFINED_L17 ', $
PRMS					;    debut parametrage
	PRM TYPE_SPEC_ofs				; in
	PRM OP_FIRST_ofs				; in
	PRM OP_LAST_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	OPL21_disp, B				; compteur boucle LOOP__1
	ULB  2,	-OP_FIRST_ofs
	SB  2,	OPL21_disp
VAR	LMT_OPL21_disp, B			; limite boucle LOOP__1
	ULB  2,	-OP_LAST_ofs
	SB  2,	LMT_OPL21_disp
	ULB  2,	OPL21_disp				; test null range LOOP__1
	ULB  2,	LMT_OPL21_disp
	CGT
	BT	L20
LOOP__1:					; corps boucle LOOP__1
					; debut if
; CODE record equality "/=" _TREE
	LA	 1, STANDARD.IDL.SEM_PHASE_L11.PRENAME.BLTN_ID_ARRAY_disp	; array data start address on stack
	ULB 2,	OPL21_disp
	DUP
	LID	1, STANDARD.IDL.SEM_PHASE_L11.PRENAME.BLTN_ID_ARRAY__u, STANDARD.IDL.SEM_PHASE_L11.PRENAME._BLTN_ID_ARRAY__type.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LID	1, STANDARD.IDL.SEM_PHASE_L11.PRENAME.BLTN_ID_ARRAY__u, STANDARD.IDL.SEM_PHASE_L11.PRENAME._BLTN_ID_ARRAY__type.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LID	1, STANDARD.IDL.SEM_PHASE_L11.PRENAME.BLTN_ID_ARRAY__u, STANDARD.IDL.SEM_PHASE_L11.PRENAME._BLTN_ID_ARRAY__type.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LID	1, STANDARD.IDL.SEM_PHASE_L11.PRENAME.BLTN_ID_ARRAY__u, STANDARD.IDL.SEM_PHASE_L11.PRENAME._BLTN_ID_ARRAY__type.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LD
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	LA
	LD
	CEQ
	LI	1
	OUX
	BF	L23
namespace	BLOCK__2
ELB 3					;    BODY ELAB
 hexa_show 'var elab DEFLIST ', $
VAR DEFLIST_disp, Q				; variable record : pointeur aux data record
VAR DEFLIST__u, Q				; variable record : pointeur aux useinfo
VAR DEFLIST__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA	3, DEFLIST__dat
	SA	3, DEFLIST_disp				; record fin
	LVA	3, STANDARD.IDL._SEQ_TYPE.SIZ__
	SA	3, DEFLIST__u
	LA  3, DEFLIST_disp
	LI	STANDARD.IDL._SEQ_TYPE.size
VAR	ANON_86_25_disp, Q
VAR	ANON_86_25__u,    Q
VAR	ANON_86_25__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA 3, ANON_86_25__dat
	SA  3, ANON_86_25_disp
	LA  0, STANDARD.IDL._SEQ_TYPE.use__info
	SA  3, ANON_86_25__u
	LVA 3, ANON_86_25_disp
					; doublet resultat record anonyme
