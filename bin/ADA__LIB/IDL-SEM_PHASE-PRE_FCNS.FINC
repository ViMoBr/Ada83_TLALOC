if defined GEN_IN_L1_
PRO	GEN_IN_L1				;---------- PRO GEN_IN
 hexa_show 'GEN_IN_L1 ', $
PRMS					;    debut parametrage
	PRM SYMREP_ofs				; in
	PRM TYPE_SPEC_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
; CODE_RETURN : EXPR TYPE = DN_RECORD  VUE COMPLETE = DN_RECORD
	LA   2,	-result__ofs
	LA  ,  0
	LI	STANDARD.IDL._TREE.size
VAR	ANON_48_12_disp, Q
VAR	ANON_48_12__u,    Q
VAR	ANON_48_12__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_48_12__dat
	SA  2, ANON_48_12_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_48_12__u
	LVA 2, ANON_48_12_disp
					; doublet resultat record anonyme
	LI  0
	LVA  0,	STANDARD.IDL.TREE_VOID_disp		; array actual
	LVA  0,	STANDARD.IDL.TREE_VOID_disp		; array actual
	LVA  0,	STANDARD.IDL.TREE_VOID_disp		; array actual
VAR	ANON_48_41_disp, Q
VAR	ANON_48_41__u,    Q
VAR	ANON_48_41__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_48_41__dat
	SA  2, ANON_48_41_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_48_41__u
	LVA 2, ANON_48_41_disp
					; doublet resultat record anonyme
	LVA  0,	STANDARD.IDL.TREE_VOID_disp		; array actual
VAR	ANON_48_69_disp, Q
VAR	ANON_48_69__u,    Q
VAR	ANON_48_69__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA 2, ANON_48_69__dat
	SA  2, ANON_48_69_disp
	LA  0, STANDARD.IDL._SEQ_TYPE.use__info
	SA  2, ANON_48_69__u
	LVA 2, ANON_48_69_disp
					; doublet resultat record anonyme
VAR	ANON_48_80_disp, Q
VAR	ANON_48_80__u,    Q
VAR	ANON_48_80__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_48_80__dat
	SA  2, ANON_48_80_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_48_80__u
	LVA 2, ANON_48_80_disp
					; doublet resultat record anonyme
	LVA  0,	STANDARD.IDL.TREE_VOID_disp		; array actual
	LVA  0,	STANDARD.IDL.TREE_VOID_disp		; array actual
	LVA  0,	STANDARD.IDL.TREE_VOID_disp		; array actual
	LA  2,	-TYPE_SPEC_ofs
	LA  2,	-SYMREP_ofs
	LVA  0,	STANDARD.IDL.TREE_VOID_disp		; array actual
	CALL	STANDARD.IDL.SEM_PHASE_L11.MAKE_NOD. ,MAKE_IN_ID_L232
	CALL	STANDARD.IDL.IDL_MAN. ,SINGLETON_L35
	CALL	STANDARD.IDL.SEM_PHASE_L11.MAKE_NOD. ,MAKE_SOURCE_NAME_S_L318
	CALL	STANDARD.IDL.SEM_PHASE_L11.MAKE_NOD. ,MAKE_IN_L258
	LA
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINKR 2
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO GEN_IN
end if

