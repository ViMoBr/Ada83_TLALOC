	LVA 3,	S1_disp
; CODE CONVERSION SOURCE DN_RECORD TARGET DN_RECORD
	LA
	BLKMOV
	UNLINK 3
	BRA ret_lbl
	UNLINKR 3
endPRO
	BRA	L13
L14:
; CODE_RETURN : EXPR TYPE = DN_PRIVATE  VUE COMPLETE = DN_RECORD
	LA   2,	-result__ofs
	LA  ,  0
	LI	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._EXTRAINFO_TYPE.size
	LVA 1,	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.NULL_EXTRAINFO_disp
	LA
	BLKMOV
	BRA ret_lbl
L13:					; post if
ret_lbl:
	UNLINKR 2
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO GET_EXTRAINFO
end if

