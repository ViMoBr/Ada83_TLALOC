SET_UTIL = 'SET_UTIL'
namespace SET_UTIL				;---------- PACKAGE (BDY)
					;    BODY ELAB
					; sub program entry decl (in instantiation FALSE )
					; sub program entry decl (in instantiation FALSE )
					; sub program entry decl (in instantiation FALSE )

if defined GET_DEF_L82_
PRO	GET_DEF_L82				;---------- PRO GET_DEF
 hexa_show 'GET_DEF_L82 ', $
PRMS					;    debut parametrage
	PRM DEFINTERP_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
 hexa_show 'var elab DEF ', $
VAR DEF_disp, Q				; variable record : pointeur aux data record
VAR DEF__u, Q				; variable record : pointeur aux useinfo
VAR DEF__dat, STANDARD.IDL._TREE.size
	LVA	2, DEF__dat
	SA	2, DEF_disp				; record fin
	LVA	2, STANDARD.IDL._TREE.SIZ__
	SA	2, DEF__u
	LA  2, DEF_disp
	LI	STANDARD.IDL._TREE.size
	LA  2,	-DEFINTERP_ofs
; CODE CONVERSION SOURCE DN_RECORD TARGET DN_RECORD
	LA
	BLKMOV

 hexa_show ' disp ', DEF_disp
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	LA	2, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.GET_DEF_L82.DEF_disp
	LD
	LI	24
	LI	8
	UBFX
	LI	229
	CEQ
	DUP
	BT	L8
	DROP
	LA	2, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.GET_DEF_L82.DEF_disp
	LD
	LI	24
	LI	8
	UBFX
	LI	230
	CEQ
L8:
	BF	L7
	LVA 2,	DEF_disp
	LA
	LI	STANDARD.IDL._TREE.size
VAR	ANON_26_14_disp, Q
VAR	ANON_26_14__u,    Q
VAR	ANON_26_14__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_26_14__dat
	SA  2, ANON_26_14_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_26_14__u
	LVA 2, ANON_26_14_disp
					; doublet resultat record anonyme
	LVA 2,	DEF_disp
	LI  167
	CALL	STANDARD.IDL. ,D_L17
	LA
	BLKMOV
	BRA	L6
L7:
L6:					; post if
; CODE_RETURN : EXPR TYPE = DN_RECORD  VUE COMPLETE = DN_RECORD
	LA   2,	-result__ofs
	LA  ,  0
	LI	STANDARD.IDL._TREE.size
	LVA 2,	DEF_disp
	LA
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINKR 2
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO GET_DEF
end if

