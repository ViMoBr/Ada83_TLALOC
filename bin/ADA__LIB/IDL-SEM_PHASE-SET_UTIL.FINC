	LVA	3, S1__dat
	SA	3, S1_disp				; record fin
	LVA	3, STANDARD.IDL._SEQ_TYPE.SIZ__
	SA	3, S1__u
	LA  3, S1_disp
	LI	STANDARD.IDL._SEQ_TYPE.size
VAR	ANON_45_26_disp, Q
VAR	ANON_45_26__u,    Q
VAR	ANON_45_26__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA 3, ANON_45_26__dat
	SA  3, ANON_45_26_disp
	LA  0, STANDARD.IDL._SEQ_TYPE.use__info
	SA  3, ANON_45_26__u
	LVA 3, ANON_45_26_disp
					; doublet resultat record anonyme
	LA  2,	-DEFINTERP_ofs
; CODE CONVERSION SOURCE DN_RECORD TARGET DN_RECORD
	CALL	STANDARD.IDL. ,LIST_L22
	LA
	BLKMOV

 hexa_show ' disp ', S1_disp
					;    end elab
