begin:					;---------- BDY INSTRUCTIONS
; CODE_RETURN : EXPR TYPE = DN_PRIVATE  VUE COMPLETE = DN_RECORD
	LA   2,	-result__ofs
	LA  ,  0
	LI	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._TYPESET_TYPE.size
VAR	ANON_561_26_disp, Q
VAR	ANON_561_26__u,    Q
VAR	ANON_561_26__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA 2, ANON_561_26__dat
	SA  2, ANON_561_26_disp
	LA  0, STANDARD.IDL._SEQ_TYPE.use__info
	SA  2, ANON_561_26__u
	LVA 2, ANON_561_26_disp
					; doublet resultat record anonyme
VAR	ANON_561_41_disp, Q
VAR	ANON_561_41__u,    Q
VAR	ANON_561_41__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_561_41__dat
	SA  2, ANON_561_41_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_561_41__u
	LVA 2, ANON_561_41_disp
					; doublet resultat record anonyme
	LA  2,	-EXP_ofs
	LI  87
	CALL	STANDARD.IDL. ,D_L17
	CALL	STANDARD.IDL.SEM_PHASE_L11.VIS_UTIL. ,CAST_SEQ_TYPE_L178
; CODE CONVERSION SOURCE DN_RECORD TARGET DN_RECORD
	LA
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINKR 2
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO FETCH_TYPESET
end if

