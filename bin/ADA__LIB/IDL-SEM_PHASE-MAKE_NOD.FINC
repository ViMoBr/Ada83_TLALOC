MAKE_NOD = 'MAKE_NOD'
namespace MAKE_NOD				;---------- PACKAGE (BDY)
					;    BODY ELAB

if defined MAKE_VARIABLE_ID_L227_
PRO	MAKE_VARIABLE_ID_L227			;---------- PRO MAKE_VARIABLE_ID
 hexa_show 'MAKE_VARIABLE_ID_L227 ', $
PRMS					;    debut parametrage
	PRM LX_SRCPOS_ofs				; in
	PRM LX_SYMREP_ofs				; in
	PRM SM_OBJ_TYPE_ofs			; in
	PRM SM_INIT_EXP_ofs			; in
	PRM SM_RENAMES_OBJ_ofs			; in
	PRM SM_ADDRESS_ofs				; in
	PRM SM_IS_SHARED_ofs			; in
	PRM XD_REGION_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
 hexa_show 'var elab NODE ', $
VAR NODE_disp, Q				; variable record : pointeur aux data record
VAR NODE__u, Q				; variable record : pointeur aux useinfo
VAR NODE__dat, STANDARD.IDL._TREE.size
	LVA	2, NODE__dat
	SA	2, NODE_disp				; record fin
	LVA	2, STANDARD.IDL._TREE.SIZ__
	SA	2, NODE__u
	LA  2, NODE_disp
	LI	STANDARD.IDL._TREE.size
VAR	ANON_25_22_disp, Q
VAR	ANON_25_22__u,    Q
VAR	ANON_25_22__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_25_22__dat
	SA  2, ANON_25_22_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_25_22__u
	LVA 2, ANON_25_22_disp
					; doublet resultat record anonyme
	LI  12
	CALL	STANDARD.IDL. ,MAKE_L15
	LA
	BLKMOV

 hexa_show ' disp ', NODE_disp
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LA  2,	-LX_SRCPOS_ofs
	LVA 2,	NODE_disp
	LI	 154
	CALL	STANDARD.IDL. ,D_L16
	LA  2,	-LX_SYMREP_ofs
	LVA 2,	NODE_disp
	LI	 13
	CALL	STANDARD.IDL. ,D_L16
	LA  2,	-SM_OBJ_TYPE_ofs
	LVA 2,	NODE_disp
	LI	 15
	CALL	STANDARD.IDL. ,D_L16
	LA  2,	-SM_INIT_EXP_ofs
	LVA 2,	NODE_disp
	LI	 24
	CALL	STANDARD.IDL. ,D_L16
	ULB  2,	-SM_RENAMES_OBJ_ofs
	LVA 2,	NODE_disp
	LI	 25
	CALL	STANDARD.IDL. ,DB_L18
	LA  2,	-SM_ADDRESS_ofs
	LVA 2,	NODE_disp
	LI	 26
	CALL	STANDARD.IDL. ,D_L16
	ULB  2,	-SM_IS_SHARED_ofs
	LVA 2,	NODE_disp
	LI	 31
	CALL	STANDARD.IDL. ,DB_L18
	LA  2,	-XD_REGION_ofs
	LVA 2,	NODE_disp
	LI	 14
	CALL	STANDARD.IDL. ,D_L16
; CODE_RETURN : EXPR TYPE = DN_RECORD  VUE COMPLETE = DN_RECORD
	LA   2,	-result__ofs
	LA  ,  0
	LI	STANDARD.IDL._TREE.size
	LVA 2,	NODE_disp
	LA
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINK 2
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO MAKE_VARIABLE_ID
end if

