	LVA	2, NODE__dat
	SA	2, NODE_disp				; record fin
	LVA	2, STANDARD.IDL._TREE.SIZ__
	SA	2, NODE__u
	LA  2, NODE_disp
	LI	STANDARD.IDL._TREE.size
VAR	ANON_2483_24_disp, Q
VAR	ANON_2483_24__u,    Q
VAR	ANON_2483_24__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_2483_24__dat
	SA  2, ANON_2483_24_disp
