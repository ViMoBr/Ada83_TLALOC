PRMS					;    debut parametrage
	PRM AS_TEST_CLAUSE_ELEM_S_ofs		; in
	PRM AS_STM_S_ofs				; in
	PRM LX_SRCPOS_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
 hexa_show 'var elab NODE ', $
VAR NODE_disp, Q				; variable record : pointeur aux data record
VAR NODE__u, Q				; variable record : pointeur aux useinfo
VAR NODE__dat, STANDARD.IDL._TREE.size
	LVA	2, NODE__dat
	SA	2, NODE_disp				; record fin
	LVA	2, STANDARD.IDL._TREE.SIZ__
	SA	2, NODE__u
	LA  2, NODE_disp
	LI	STANDARD.IDL._TREE.size
VAR	ANON_1583_24_disp, Q
VAR	ANON_1583_24__u,    Q
VAR	ANON_1583_24__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_1583_24__dat
	SA  2, ANON_1583_24_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_1583_24__u
	LVA 2, ANON_1583_24_disp
					; doublet resultat record anonyme
	LI  126
	CALL	STANDARD.IDL. ,MAKE_L15
	LA
	BLKMOV

 hexa_show ' disp ', NODE_disp
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LA  2,	-AS_TEST_CLAUSE_ELEM_S_ofs
	LVA 2,	NODE_disp
	LI	 99
	CALL	STANDARD.IDL. ,D_L16
	LA  2,	-AS_STM_S_ofs
	LVA 2,	NODE_disp
	LI	 100
	CALL	STANDARD.IDL. ,D_L16
	LA  2,	-LX_SRCPOS_ofs
	LVA 2,	NODE_disp
	LI	 154
	CALL	STANDARD.IDL. ,D_L16
; CODE_RETURN : EXPR TYPE = DN_RECORD  VUE COMPLETE = DN_RECORD
	LA   2,	-result__ofs
	LA  ,  0
	LI	STANDARD.IDL._TREE.size
	LVA 2,	NODE_disp
	LA
	BLKMOV
	BRA ret_lbl
ret_lbl:
	UNLINK 2
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO MAKE_IF
end if

