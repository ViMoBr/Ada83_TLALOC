VAR FST_disp, Q				; variable record : pointeur aux data record
VAR FST__u, Q				; variable record : pointeur aux useinfo
VAR FST__dat, STANDARD.IDL._TREE.size
	LVA	3, FST__dat
	SA	3, FST_disp				; record fin
	LVA	3, STANDARD.IDL._TREE.SIZ__
	SA	3, FST__u
	LA  3, FST_disp
					; store represented component PT range 0 .. 1 width 2
	DUP
	LD
	LI	0
	LI	0
	LI	2
	BFI
	SD

 hexa_show ' disp ', FST_disp
 hexa_show 'var elab LST ', $
VAR LST_disp, Q				; variable record : pointeur aux data record
VAR LST__u, Q				; variable record : pointeur aux useinfo
VAR LST__dat, STANDARD.IDL._TREE.size
	LVA	3, LST__dat
	SA	3, LST_disp				; record fin
	LVA	3, STANDARD.IDL._TREE.SIZ__
	SA	3, LST__u
