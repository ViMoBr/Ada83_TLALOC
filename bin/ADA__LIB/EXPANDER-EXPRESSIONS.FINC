if defined GCD_L4282_
PRO	GCD_L4282				;---------- PRO GCD
 hexa_show 'GCD_L4282 ', $
PRMS					;    debut parametrage
	PRM A_ofs				; in
	PRM B_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
 hexa_show 'var elab X ', $
VAR X_disp, Q				; variable entiere
	LQ  2,	-A_ofs
	ABS
	SQ  2,	X_disp

 hexa_show ' disp ', X_disp
 hexa_show 'var elab Y ', $
VAR Y_disp, Q				; variable entiere
	LQ  2,	-B_ofs
	ABS
	SQ  2,	Y_disp

 hexa_show ' disp ', Y_disp
 hexa_show 'var elab T ', $
VAR T_disp, Q				; variable entiere

 hexa_show ' disp ', T_disp
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
LOOP__174:
	LQ 2,	Y_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	CNE
	BF	L4285
	LQ 2,	Y_disp
	SQ  2,	T_disp
	LQ 2,	X_disp
	LQ 2,	Y_disp
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	MODI
	SQ  2,	Y_disp
	LQ 2,	T_disp
	SQ  2,	X_disp
	BRA	LOOP__174
L4285:					; post loop LOOP__174
; CODE_RETURN : EXPR TYPE = DN_INTEGER  VUE COMPLETE = DN_INTEGER
	LQ 2,	X_disp
	SQ  2,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 2
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO GCD
end if

