 hexa_show 'var elab OP ', $
VAR OP_disp, Q				; variable record : pointeur aux data record
VAR OP__u, Q				; variable record : pointeur aux useinfo
VAR OP__dat, STANDARD.IDL._TREE.size
	LVA	2, OP__dat
	SA	2, OP_disp				; record fin
	LVA	2, STANDARD.IDL._TREE.SIZ__
	SA	2, OP__u
	LA  2, OP_disp
	LI	STANDARD.IDL._TREE.size
