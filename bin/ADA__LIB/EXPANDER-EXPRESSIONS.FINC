	LVA 2,	STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_CONVERSION_L72.TARGET_TYPE_disp
	LI  35
	CALL	STANDARD.IDL. ,D_L17
	LA
	BLKMOV

 hexa_show ' disp ', TYPE_NAME_disp
 hexa_show 'var elab TARGET_TYPE_STR ', $
