					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
; CODE record equality "=" _TREE
	LA  3,	-RNG_ofs
	LA
	LD
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	LA
	LD
	CEQ
	BF	L3658
STR STR_L3659, "; CODE_ARRAY_AGGREGATE : range de dimension absente"	; constante string="; CODE_ARRAY_AGGREGATE : range de dimension absente"
	LCA	STR_L3659.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LCA	STANDARD.PROGRAM_ERROR__exc.data_ptr
	SA	0, STANDARD.EXCEPTIONS_CURRENT_disp
	BRA	STANDARD.exc_raise_
	BRA	L3657
L3658:
L3657:					; post if
					; debut if
	LD 2,	STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L3608.NB_DIMS_disp
	LD 2,	STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L3608.MAX_DIMS_disp
	CEQ
	BF	L3661
STR STR_L3662, "; CODE_ARRAY_AGGREGATE : plus de 8 dimensions"	; constante string="; CODE_ARRAY_AGGREGATE : plus de 8 dimensions"
	LCA	STR_L3662.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LCA	STANDARD.PROGRAM_ERROR__exc.data_ptr
	SA	0, STANDARD.EXCEPTIONS_CURRENT_disp
	BRA	STANDARD.exc_raise_
	BRA	L3660
L3661:
L3660:					; post if
	LD 2,	STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L3608.NB_DIMS_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	DUP
	LD	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD._NATURAL.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  2,	STANDARD.EXPANDER_L1.EXPRESSIONS.CODE_ARRAY_AGGREGATE_L3608.NB_DIMS_disp
	LVA 3,	FST_disp
	LA
	LI	STANDARD.IDL._TREE.size
