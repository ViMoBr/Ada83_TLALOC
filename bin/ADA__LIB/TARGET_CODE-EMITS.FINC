	LID	1, STANDARD.TARGET_CODE_L1.EMITS.BIN__u, STANDARD.TARGET_CODE_L1.EMITS._BIN__type.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LID	1, STANDARD.TARGET_CODE_L1.EMITS.BIN__u, STANDARD.TARGET_CODE_L1.EMITS._BIN__type.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LID	1, STANDARD.TARGET_CODE_L1.EMITS.BIN__u, STANDARD.TARGET_CODE_L1.EMITS._BIN__type.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LD
	LVA 2,	F_disp
	CALL	STANDARD.TARGET_CODE_L1.EMITS.BIO. ,WRITE_L12
	LD  2,	IL397_disp				; test de sortie LOOP__27
	LD  2,	LMT_IL397_disp
	CEQ
	BT	L396
	LD  2,	IL397_disp				; mise a jour compteur LOOP__27
	INC
	SD  2,	IL397_disp
	BRA	LOOP__27				; iteration suivante LOOP__27
L396:					; post loop LOOP__27
	LVA  2,	STANDARD.TARGET_CODE_L1.EMITS.P3_EMIT_L58.F_disp
	CALL	STANDARD.TARGET_CODE_L1.EMITS.BIO. ,CLOSE_L3
	ULD 2,	S0_disp
	CALL	STANDARD.TARGET_CODE_L1.SYMBOLS. ,USE_SCOPE_L11
	LD	0, STANDARD._NATURAL.LST
	DUP
	LD	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD._NATURAL.LST
	CGT
	BT	STANDARD.ce_raise_
	CALL	STANDARD.TARGET_CODE_L1.SYMBOLS. ,SET_EPOCH_L21
ret_lbl:
	UNLINKR 2
	RTD	prm_siz
excep:
endPRO					;---------- end PRO P3_EMIT
end if

if defined BIN_CAPACITY_L60_
PRO	BIN_CAPACITY_L60			;---------- PRO BIN_CAPACITY
 hexa_show 'BIN_CAPACITY_L60 ', $
PRMS					;    debut parametrage
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
; CODE_RETURN : EXPR TYPE = DN_UNIVERSAL_INTEGER  VUE COMPLETE = DN_UNIVERSAL_INTEGER
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	32000000
	DUP
	LD	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD._NATURAL.LST
	CGT
	BT	STANDARD.ce_raise_
	SQ  2,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINKR 2
	RTD
excep:
endPRO					;---------- end PRO BIN_CAPACITY
end if
begin:					;---------- package BDY INSTRUCTIONS
end namespace 				;---------- end package BDY EMITS

