	CGT
	BT	STANDARD.ce_raise_
	ULD  2,	-E_ofs
	CALL	STANDARD.TARGET_CODE_L1.EMITS. ,OPV_L92
	SQ  3,	LVL_disp

 hexa_show ' disp ', LVL_disp
