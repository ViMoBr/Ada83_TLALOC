	SQ  1,	STANDARD.TARGET_CODE_L1.EMITS.COPILE_RESERVE_disp

 hexa_show ' disp ', COPILE_RESERVE_disp

					; _BYTE INTEGER SUBTYPE INFO
_BYTE = '_BYTE'
namespace _BYTE
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
VAR FST, D
VAR LST, D
	LI	32
	SD	1, SIZ__
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	SD	1, FST
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	255
	SD	1, LST
VAR PARENT__u, Q
	LA	0, STANDARD._INTEGER.use__info
	SA	1, PARENT__u
end namespace
 hexa_show 'var elab BIN ', $
_BIN__type = '_BIN__type'
namespace _BIN__type			; array var constrained array type info
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
VAR _COMP_SIZ, D
VAR _FST_1, D
VAR _LST_1, D
	LI	32
	SD	1, _COMP_SIZ
	LD	1, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	SD	1, _FST_1
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	32000000
	SD	1, _LST_1
	LD	1, _LST_1
	LD	1, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	SD	1, SIZ__
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR BIN_disp, Q				; variable array : pointeur aux data
VAR BIN__u, Q				; variable array : useinfo pointeur au rec info
	LA 1, _BIN__type.use__info
	SA	1, BIN__u				; array info ptr at __u
	LD	1, _BIN__type.SIZ__
	LI	8
	DIV
	CO_VAR
	SA	1, BIN_disp				; array data ptr at _disp

 hexa_show ' disp ', BIN_disp
 hexa_show 'var elab TOP ', $
VAR TOP_disp, D				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	SD  1,	STANDARD.TARGET_CODE_L1.EMITS.TOP_disp

 hexa_show ' disp ', TOP_disp
 hexa_show 'var elab ASM ', $
VAR ASM_disp, Q				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	SQ  1,	STANDARD.TARGET_CODE_L1.EMITS.ASM_disp

 hexa_show ' disp ', ASM_disp

if defined FAULT_L14_
PRO	FAULT_L14				;---------- PRO FAULT
 hexa_show 'FAULT_L14 ', $
PRMS					;    debut parametrage
	PRM MSG_ofs				; in
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
; CODE & concat _STRING
VAR	ANON_72_15_L17_G_data, Q
VAR	ANON_72_15_L17_G_info, Q
VAR	ANON_72_40_L17_D_data, Q
VAR	ANON_72_40_L17_D_info, Q
VAR	ANON_72_15_L17_G_len,  Q
VAR	ANON_72_40_L17_D_len,  Q
VAR	ANON_72_15_L17_R_disp, Q
VAR	ANON_72_15_L17_R__u,   Q
namespace ANON_72_15_L17_R_info
  VAR SIZ__, D
  VAR _COMP_SIZ, D
  VAR _FST_1, D
  VAR _LST_1, D
end namespace
STR ANON_72_15_L17_G, "TARGET_CODE.EMITS : "	; constante string="TARGET_CODE.EMITS : "
	LCA	ANON_72_15_L17_G.data_ptr
	DUP
	LA  ,  0
	SA  2, ANON_72_15_L17_G_data
	LA  ,  8
	SA  2, ANON_72_15_L17_G_info
	LID 2, ANON_72_15_L17_G_info, _STRING.LST_1
	LID 2, ANON_72_15_L17_G_info, _STRING.FST_1
	SUB
	INC
	CLAMP0
	SA  2, ANON_72_15_L17_G_len
	LA  2,	-MSG_ofs
	DUP
	LA  ,  0
	SA  2, ANON_72_40_L17_D_data
	LA  ,  8
	SA  2, ANON_72_40_L17_D_info
	LID 2, ANON_72_40_L17_D_info, _STRING.LST_1
	LID 2, ANON_72_40_L17_D_info, _STRING.FST_1
	SUB
	INC
	CLAMP0
	SA  2, ANON_72_40_L17_D_len
	LA  2, ANON_72_15_L17_G_len
	LA  2, ANON_72_40_L17_D_len
	ADD
	CO_VAR
	SA  2, ANON_72_15_L17_R_disp
	LI	1
	SD  2, ANON_72_15_L17_R_info._FST_1
	LA  2, ANON_72_15_L17_G_len
	LA  2, ANON_72_40_L17_D_len
	ADD
	SD  2, ANON_72_15_L17_R_info._LST_1
	LI	8
	SD  2, ANON_72_15_L17_R_info._COMP_SIZ
	LA  2, ANON_72_15_L17_G_len
	LA  2, ANON_72_40_L17_D_len
	ADD
	LI	8
	MUL
	SD  2, ANON_72_15_L17_R_info.SIZ__
	LVA 2, ANON_72_15_L17_R_info.SIZ__
	SA  2, ANON_72_15_L17_R__u
	LA  2, ANON_72_15_L17_R_disp
	LA  2, ANON_72_15_L17_G_len
	LA  2, ANON_72_15_L17_G_data
	BLKMOV
	LA  2, ANON_72_15_L17_R_disp
	LA  2, ANON_72_15_L17_G_len
	ADD
	LA  2, ANON_72_40_L17_D_len
	LA  2, ANON_72_40_L17_D_data
	BLKMOV
	LVA 2, ANON_72_15_L17_R_disp
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LCA	STANDARD.TARGET_CODE_L1.EMITS.EMIT_FAULT__exc.data_ptr
	SA	0, STANDARD.EXCEPTIONS_CURRENT_disp
	BRA	STANDARD.exc_raise_
ret_lbl:
	UNLINK 2
	RTD	prm_siz
excep:
endPRO					;---------- end PRO FAULT
end if

if defined B_L18_
PRO	B_L18					;---------- PRO B
 hexa_show 'B_L18 ', $
PRMS					;    debut parametrage
	PRM V_ofs				; in
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut if
	LD 1,	STANDARD.TARGET_CODE_L1.EMITS.TOP_disp
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	32000000
	CGT
	BF	L22
STR STR_L23, "tampon binaire plein (BIN_MAX)"	; constante string="tampon binaire plein (BIN_MAX)"
	LCA	STR_L23.data_ptr
	CALL	STANDARD.TARGET_CODE_L1.EMITS. ,FAULT_L14
	BRA	L21
L22:
L21:					; post if
	LA	 1, STANDARD.TARGET_CODE_L1.EMITS.BIN_disp	; array data start address on stack
	LD 1,	STANDARD.TARGET_CODE_L1.EMITS.TOP_disp
	DUP
	LID	1, STANDARD.TARGET_CODE_L1.EMITS.BIN__u, STANDARD.TARGET_CODE_L1.EMITS._BIN__type.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LID	1, STANDARD.TARGET_CODE_L1.EMITS.BIN__u, STANDARD.TARGET_CODE_L1.EMITS._BIN__type.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LID	1, STANDARD.TARGET_CODE_L1.EMITS.BIN__u, STANDARD.TARGET_CODE_L1.EMITS._BIN__type.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LID	1, STANDARD.TARGET_CODE_L1.EMITS.BIN__u, STANDARD.TARGET_CODE_L1.EMITS._BIN__type.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LD  2,	-V_ofs
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	256
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	MODI
	SD
	LD 1,	STANDARD.TARGET_CODE_L1.EMITS.TOP_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	SD  1,	STANDARD.TARGET_CODE_L1.EMITS.TOP_disp
ret_lbl:
	UNLINK 2
	RTD	prm_siz
excep:
endPRO					;---------- end PRO B
end if

