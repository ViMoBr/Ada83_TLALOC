endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
 hexa_show 'var elab U ', $
VAR U_disp, D				; variable entiere
	LD  2,	-V_ofs
	SD  2,	U_disp

 hexa_show ' disp ', U_disp
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	IL31_disp, D				; compteur boucle LOOP__1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SD  2,	IL31_disp
VAR	LMT_IL31_disp, D			; limite boucle LOOP__1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	4
	SD  2,	LMT_IL31_disp
	LD  2,	IL31_disp				; test null range LOOP__1
	LD  2,	LMT_IL31_disp
	CGT
	BT	L30
LOOP__1:					; corps boucle LOOP__1
	LD 2,	U_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	256
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	MODI
	CALL	STANDARD.TARGET_CODE_L1.EMITS. ,B_L18
	LD 2,	U_disp
	LD 2,	U_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	256
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
