 hexa_show 'var elab DEBUG_RED_SUBP ', $
VAR DEBUG_RED_SUBP_disp, B			; variable bool char enum
	LI	0
	SB  1,	STANDARD.IDL.SEM_PHASE_L11.RED_SUBP.DEBUG_RED_SUBP_disp

 hexa_show ' disp ', DEBUG_RED_SUBP_disp

					; _ACTUAL_TYPE RECORD TYPE INFO
_ACTUAL_TYPE = '_ACTUAL_TYPE'
namespace _ACTUAL_TYPE
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
USEINFO 1, SYM, 	LA 0, STANDARD.IDL._TREE.use__info
USEINFO 1, EXP, 	LA 0, STANDARD.IDL._TREE.use__info
USEINFO 1, TYPESET, 	LA 1, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._TYPESET_TYPE.use__info
virtual at 0				; calcul des offsets statiques
STATOFS SYM, 4, 8
STATOFS EXP, 4, 8
STATOFS TYPESET, 12, 8
size = $
end virtual
	LI	 size*8
	SD	1, SIZ__
end namespace

					; _ACTUAL_ARRAY_TYPE UNCONSTRAINED ARRAY SUBTYPE INFO
_ACTUAL_ARRAY_TYPE = '_ACTUAL_ARRAY_TYPE'
namespace _ACTUAL_ARRAY_TYPE
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
	LI	1
	NEG
	SD	1, SIZ__
  virtual at 4				; use info offsets pour acces sur array contraint

COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
