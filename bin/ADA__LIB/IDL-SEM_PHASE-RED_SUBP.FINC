 hexa_show 'CHECK_SUBSCRIPT_LIST_L10 ', $
PRMS					;    debut parametrage
	PRM ARRAY_TYPE_ofs				; in
	PRM ACTUAL_ofs				; in
	PRM ACTUALS_OK_ofs				; out
	PRM EXTRAINFO_ofs				; out
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
 hexa_show 'var elab INDEX_LIST ', $
VAR INDEX_LIST_disp, Q			; variable record : pointeur aux data record
VAR INDEX_LIST__u, Q			; variable record : pointeur aux useinfo
VAR INDEX_LIST__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA	2, INDEX_LIST__dat
	SA	2, INDEX_LIST_disp			; record fin
	LVA	2, STANDARD.IDL._SEQ_TYPE.SIZ__
	SA	2, INDEX_LIST__u
	LA  2, INDEX_LIST_disp
	LI	STANDARD.IDL._SEQ_TYPE.size
VAR	ANON_1021_32_disp, Q
VAR	ANON_1021_32__u,    Q
VAR	ANON_1021_32__dat, STANDARD.IDL._SEQ_TYPE.size
	LVA 2, ANON_1021_32__dat
	SA  2, ANON_1021_32_disp
	LA  0, STANDARD.IDL._SEQ_TYPE.use__info
	SA  2, ANON_1021_32__u
	LVA 2, ANON_1021_32_disp
					; doublet resultat record anonyme
VAR	ANON_1021_38_disp, Q
VAR	ANON_1021_38__u,    Q
VAR	ANON_1021_38__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_1021_38__dat
	SA  2, ANON_1021_38_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_1021_38__u
	LVA 2, ANON_1021_38_disp
					; doublet resultat record anonyme
	LA  2,	-ARRAY_TYPE_ofs
	LI  61
	CALL	STANDARD.IDL. ,D_L17
	CALL	STANDARD.IDL. ,LIST_L22
	LA
	BLKMOV

 hexa_show ' disp ', INDEX_LIST_disp
 hexa_show 'var elab INDEX ', $
VAR INDEX_disp, Q				; variable record : pointeur aux data record
VAR INDEX__u, Q				; variable record : pointeur aux useinfo
VAR INDEX__dat, STANDARD.IDL._TREE.size
	LVA	2, INDEX__dat
	SA	2, INDEX_disp				; record fin
	LVA	2, STANDARD.IDL._TREE.SIZ__
	SA	2, INDEX__u
	LA  2, INDEX_disp
					; store represented component PT range 0 .. 1 width 2
	DUP
	LD
	LI	0
	LI	0
	LI	2
	BFI
	SD

 hexa_show ' disp ', INDEX_disp
 hexa_show 'var elab NEW_EXTRAINFO ', $
VAR NEW_EXTRAINFO_disp, Q			; variable record : pointeur aux data record
VAR NEW_EXTRAINFO__u, Q			; variable record : pointeur aux useinfo
VAR NEW_EXTRAINFO__dat, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._EXTRAINFO_TYPE.size
	LVA	2, NEW_EXTRAINFO__dat
	SA	2, NEW_EXTRAINFO_disp			; record fin
	LVA	2, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._EXTRAINFO_TYPE.SIZ__
	SA	2, NEW_EXTRAINFO__u
	LA  2, NEW_EXTRAINFO_disp
	LI	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._EXTRAINFO_TYPE.size
	LVA 1,	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.NULL_EXTRAINFO_disp
	LA
	BLKMOV

 hexa_show ' disp ', NEW_EXTRAINFO_disp
 hexa_show 'var elab NEW_ACTUALS_OK ', $
VAR NEW_ACTUALS_OK_disp, B			; variable bool char enum
	LI	1
	SB  2,	NEW_ACTUALS_OK_disp

 hexa_show ' disp ', NEW_ACTUALS_OK_disp
 hexa_show 'var elab SUB_EXTRAINFO ', $
VAR SUB_EXTRAINFO_disp, Q			; variable record : pointeur aux data record
VAR SUB_EXTRAINFO__u, Q			; variable record : pointeur aux useinfo
VAR SUB_EXTRAINFO__dat, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._EXTRAINFO_TYPE.size
	LVA	2, SUB_EXTRAINFO__dat
	SA	2, SUB_EXTRAINFO_disp			; record fin
	LVA	2, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._EXTRAINFO_TYPE.SIZ__
	SA	2, SUB_EXTRAINFO__u

 hexa_show ' disp ', SUB_EXTRAINFO_disp
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	IL436_disp, D				; compteur boucle LOOP__29
	LVA	2, -ACTUAL_ofs
	LIA	, , 8
	LD	, _ACTUAL_ARRAY_TYPE.FST_1
	SD  2,	IL436_disp
VAR	LMT_IL436_disp, D			; limite boucle LOOP__29
	LVA	2, -ACTUAL_ofs
	LIA	, , 8
	LD	, _ACTUAL_ARRAY_TYPE.LST_1
	SD  2,	LMT_IL436_disp
	LD  2,	IL436_disp				; test null range LOOP__29
	LD  2,	LMT_IL436_disp
	CGT
	BT	L435
LOOP__29:					; corps boucle LOOP__29
					; debut if
	LI	0					; lieu resultat sur pile
	LVA 2,	INDEX_LIST_disp
	CALL	STANDARD.IDL. ,IS_EMPTY_L23
	BF	L438
	LI	0
	SIB  2,	-ACTUALS_OK_ofs
	LA  2,	-EXTRAINFO_ofs
	LA
	LI	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._EXTRAINFO_TYPE.size
	LVA 1,	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.NULL_EXTRAINFO_disp
	LA
	BLKMOV
	BRA ret_lbl
	BRA	L437
L438:
L437:					; post if
	LVA  2,	STANDARD.IDL.SEM_PHASE_L11.RED_SUBP.CHECK_SUBSCRIPT_LIST_L10.INDEX_disp
	LVA  2,	STANDARD.IDL.SEM_PHASE_L11.RED_SUBP.CHECK_SUBSCRIPT_LIST_L10.INDEX_LIST_disp
	CALL	STANDARD.IDL. ,POP_L24
	LVA  2,	STANDARD.IDL.SEM_PHASE_L11.RED_SUBP.CHECK_SUBSCRIPT_LIST_L10.SUB_EXTRAINFO_disp
	LVA  2,	STANDARD.IDL.SEM_PHASE_L11.RED_SUBP.CHECK_SUBSCRIPT_LIST_L10.NEW_ACTUALS_OK_disp
	VAR SELARG_L439_disp, q
	VAR SELARG_L439__u, q
	LVA	2, -ACTUAL_ofs
	LIA	, , 0				; array data start address on stack
	LD 2,	IL436_disp
	DUP
	LVA	2, -ACTUAL_ofs
	LIA	, 0,  8
	LD	, STANDARD.IDL.SEM_PHASE_L11.RED_SUBP._ACTUAL_ARRAY_TYPE.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LVA	2, -ACTUAL_ofs
	LIA	, 0,  8
	LD	, STANDARD.IDL.SEM_PHASE_L11.RED_SUBP._ACTUAL_ARRAY_TYPE.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LVA	2, -ACTUAL_ofs
	LIA	, 0,  8
	LD	, STANDARD.IDL.SEM_PHASE_L11.RED_SUBP._ACTUAL_ARRAY_TYPE.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LVA	2, -ACTUAL_ofs
	LIA	, , 8
	LD	, STANDARD.IDL.SEM_PHASE_L11.RED_SUBP._ACTUAL_ARRAY_TYPE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LVA	, STANDARD.IDL.SEM_PHASE_L11.RED_SUBP._ACTUAL_TYPE.TYPESET
	SA	2, SELARG_L439_disp
	LA 1, STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._TYPESET_TYPE.use__info
	SA	2, SELARG_L439__u
	LVA 2, SELARG_L439_disp
VAR	ANON_1035_26_disp, Q
VAR	ANON_1035_26__u,    Q
VAR	ANON_1035_26__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_1035_26__dat
	SA  2, ANON_1035_26_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_1035_26__u
	LVA 2, ANON_1035_26_disp
					; doublet resultat record anonyme
VAR	ANON_1035_41_disp, Q
VAR	ANON_1035_41__u,    Q
VAR	ANON_1035_41__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_1035_41__dat
	SA  2, ANON_1035_41_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_1035_41__u
	LVA 2, ANON_1035_41_disp
					; doublet resultat record anonyme
	LVA 2,	INDEX_disp
	LI  33
	CALL	STANDARD.IDL. ,D_L17
	CALL	STANDARD.IDL.SEM_PHASE_L11.DEF_UTIL. ,GET_BASE_TYPE_L71
	CALL	STANDARD.IDL.SEM_PHASE_L11.RED_SUBP. ,CHECK_ACTUAL_TYPE_L493
					; debut if
	ULB 2,	NEW_ACTUALS_OK_disp
	BF	L441
	LVA 2,	SUB_EXTRAINFO_disp
	LVA  2,	STANDARD.IDL.SEM_PHASE_L11.RED_SUBP.CHECK_SUBSCRIPT_LIST_L10.NEW_EXTRAINFO_disp
	CALL	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL. ,ADD_EXTRAINFO_L87
	BRA	L440
L441:
	LI	0
	SIB  2,	-ACTUALS_OK_ofs
	LA  2,	-EXTRAINFO_ofs
	LA
	LI	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._EXTRAINFO_TYPE.size
	LVA 1,	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.NULL_EXTRAINFO_disp
	LA
	BLKMOV
	BRA ret_lbl
L440:					; post if
	LD  2,	IL436_disp				; test de sortie LOOP__29
	LD  2,	LMT_IL436_disp
	CEQ
	BT	L435
	LD  2,	IL436_disp				; mise a jour compteur LOOP__29
	INC
	SD  2,	IL436_disp
	BRA	LOOP__29				; iteration suivante LOOP__29
L435:					; post loop LOOP__29
					; debut if
	LI	0					; lieu resultat sur pile
	LVA 2,	INDEX_LIST_disp
	CALL	STANDARD.IDL. ,IS_EMPTY_L23
	LI	1
	OUX
	BF	L443
	LI	0
	SIB  2,	-ACTUALS_OK_ofs
	LA  2,	-EXTRAINFO_ofs
	LA
	LI	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._EXTRAINFO_TYPE.size
	LVA 1,	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL.NULL_EXTRAINFO_disp
	LA
	BLKMOV
	BRA ret_lbl
	BRA	L442
L443:
L442:					; post if
	LI	1
	SIB  2,	-ACTUALS_OK_ofs
	LA  2,	-EXTRAINFO_ofs
	LA
	LI	STANDARD.IDL.SEM_PHASE_L11.SET_UTIL._EXTRAINFO_TYPE.size
	LVA 2,	NEW_EXTRAINFO_disp
	LA
	BLKMOV
ret_lbl:
	UNLINKR 2
	RTD	prm_siz
excep:
endPRO					;---------- end PRO CHECK_SUBSCRIPT_LIST
end if

