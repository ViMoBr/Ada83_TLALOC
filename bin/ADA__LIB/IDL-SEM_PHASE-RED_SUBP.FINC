if defined RESOLVE_SLICE_L5_
PRO	RESOLVE_SLICE_L5			;---------- PRO RESOLVE_SLICE
 hexa_show 'RESOLVE_SLICE_L5 ', $
PRMS					;    debut parametrage
	PRM NAME_ofs				; in
	PRM DISCRETE_RANGE_ofs			; in
	PRM TYPE_SPEC_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
 hexa_show 'var elab ARRAY_TYPE ', $
VAR ARRAY_TYPE_disp, Q			; variable record : pointeur aux data record
VAR ARRAY_TYPE__u, Q			; variable record : pointeur aux useinfo
VAR ARRAY_TYPE__dat, STANDARD.IDL._TREE.size
	LVA	2, ARRAY_TYPE__dat
	SA	2, ARRAY_TYPE_disp			; record fin
	LVA	2, STANDARD.IDL._TREE.SIZ__
	SA	2, ARRAY_TYPE__u
	LA  2, ARRAY_TYPE_disp
	LI	STANDARD.IDL._TREE.size
VAR	ANON_397_27_disp, Q
VAR	ANON_397_27__u,    Q
VAR	ANON_397_27__dat, STANDARD.IDL._TREE.size
	LVA 2, ANON_397_27__dat
	SA  2, ANON_397_27_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  2, ANON_397_27__u
	LVA 2, ANON_397_27_disp
					; doublet resultat record anonyme
	LA  2,	-TYPE_SPEC_ofs
	CALL	STANDARD.IDL.SEM_PHASE_L11.REQ_UTIL. ,GET_BASE_STRUCT_L108
	LA
	BLKMOV

 hexa_show ' disp ', ARRAY_TYPE_disp
 hexa_show 'var elab INDEX_TYPE ', $
VAR INDEX_TYPE_disp, Q			; variable record : pointeur aux data record
VAR INDEX_TYPE__u, Q			; variable record : pointeur aux useinfo
VAR INDEX_TYPE__dat, STANDARD.IDL._TREE.size
	LVA	2, INDEX_TYPE__dat
	SA	2, INDEX_TYPE_disp			; record fin
	LVA	2, STANDARD.IDL._TREE.SIZ__
	SA	2, INDEX_TYPE__u
	LA  2, INDEX_TYPE_disp
	LI	STANDARD.IDL._TREE.size
	LVA 0,	STANDARD.IDL.TREE_VOID_disp
	LA
