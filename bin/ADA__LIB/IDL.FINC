if defined LIST_L22_
PRO	LIST_L22				;---------- PRO LIST
 hexa_show 'LIST_L22 ', $
PRMS					;    debut parametrage
	PRM T_ofs				; in
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
 hexa_show 'var elab A_IDX ', $
VAR A_IDX_disp, D				; variable entiere
	LA	 0, STANDARD.IDL.IDL_TBL.N_SPEC_disp	; array data start address on stack
	LA 1, -T_ofs
	LA	-1, 0
	LD
	LI	24
	LI	8
	UBFX
	DUP
	LID	0, STANDARD.IDL.IDL_TBL.N_SPEC__u, STANDARD.IDL.IDL_TBL._NODE_SPECIF_TABLE.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LID	0, STANDARD.IDL.IDL_TBL.N_SPEC__u, STANDARD.IDL.IDL_TBL._NODE_SPECIF_TABLE.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LID	0, STANDARD.IDL.IDL_TBL.N_SPEC__u, STANDARD.IDL.IDL_TBL._NODE_SPECIF_TABLE.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LID	0, STANDARD.IDL.IDL_TBL.N_SPEC__u, STANDARD.IDL.IDL_TBL._NODE_SPECIF_TABLE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LD	, STANDARD.IDL.IDL_TBL._NODE_SPECIF.NS_FIRST_A
	SD  1,	A_IDX_disp

 hexa_show ' disp ', A_IDX_disp
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	IL173_disp, B				; compteur boucle LOOP__10
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SB  1,	IL173_disp
VAR	LMT_IL173_disp, B			; limite boucle LOOP__10
	LA	 0, STANDARD.IDL.IDL_TBL.N_SPEC_disp	; array data start address on stack
	LA 1, -T_ofs
	LA	-1, 0
	LD
	LI	24
	LI	8
	UBFX
	DUP
	LID	0, STANDARD.IDL.IDL_TBL.N_SPEC__u, STANDARD.IDL.IDL_TBL._NODE_SPECIF_TABLE.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LID	0, STANDARD.IDL.IDL_TBL.N_SPEC__u, STANDARD.IDL.IDL_TBL._NODE_SPECIF_TABLE.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LID	0, STANDARD.IDL.IDL_TBL.N_SPEC__u, STANDARD.IDL.IDL_TBL._NODE_SPECIF_TABLE.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LID	0, STANDARD.IDL.IDL_TBL.N_SPEC__u, STANDARD.IDL.IDL_TBL._NODE_SPECIF_TABLE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	ULB	, STANDARD.IDL.IDL_TBL._NODE_SPECIF.NS_SIZE
	SB  1,	LMT_IL173_disp
	ULB  1,	IL173_disp				; test null range LOOP__10
	ULB  1,	LMT_IL173_disp
	CGT
	BT	L172
LOOP__10:					; corps boucle LOOP__10
					; debut if
	LA	 0, STANDARD.IDL.IDL_TBL.A_SPEC_disp	; array data start address on stack
	LD 1,	A_IDX_disp
	DUP
	LID	0, STANDARD.IDL.IDL_TBL.A_SPEC__u, STANDARD.IDL.IDL_TBL._ATTR_ID_TABLE.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LID	0, STANDARD.IDL.IDL_TBL.A_SPEC__u, STANDARD.IDL.IDL_TBL._ATTR_ID_TABLE.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LID	0, STANDARD.IDL.IDL_TBL.A_SPEC__u, STANDARD.IDL.IDL_TBL._ATTR_ID_TABLE.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LID	0, STANDARD.IDL.IDL_TBL.A_SPEC__u, STANDARD.IDL.IDL_TBL._ATTR_ID_TABLE.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	ULB	, STANDARD.IDL.IDL_TBL._ATTR_SPECIF.IS_LIST
	BF	L175
; CODE_RETURN : EXPR TYPE = DN_RECORD  VUE COMPLETE = DN_RECORD
	LA   1,	-result__ofs
	LA  ,  0
					; Assign_record_aggregate type DN_RECORD
	DUP
	LVA	, STANDARD.IDL._SEQ_TYPE.FIRST
	LI	STANDARD.IDL._TREE.size
VAR	ANON_446_25_disp, Q
VAR	ANON_446_25__u,    Q
VAR	ANON_446_25__dat, STANDARD.IDL._TREE.size
	LVA 1, ANON_446_25__dat
	SA  1, ANON_446_25_disp
	LA  0, STANDARD.IDL._TREE.use__info
	SA  1, ANON_446_25__u
	LVA 1, ANON_446_25_disp
					; doublet resultat record anonyme
	LA  1,	-T_ofs
	ULB  1,	IL173_disp
	DUP
	ULB	0, STANDARD.IDL._ATTR_NBR.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULB	0, STANDARD.IDL._ATTR_NBR.LST
	CGT
	BT	STANDARD.ce_raise_
	CALL	STANDARD.IDL.IDL_MAN. ,DABS_L38
	LA
	BLKMOV
	DUP
	LVA	, STANDARD.IDL._SEQ_TYPE.NEXT
	LI	STANDARD.IDL._TREE.size
	LVA 0,	STANDARD.IDL.TREE_NIL_disp
	LA
	BLKMOV
	DROP
	BRA ret_lbl
	BRA	L174
L175:
L174:					; post if
	LD 1,	A_IDX_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	SD  1,	A_IDX_disp
	ULB  1,	IL173_disp				; test de sortie LOOP__10
	ULB  1,	LMT_IL173_disp
	CEQ
	BT	L172
	ULB  1,	IL173_disp				; mise a jour compteur LOOP__10
	INC
	SB  1,	IL173_disp
	BRA	LOOP__10				; iteration suivante LOOP__10
L172:					; post loop LOOP__10
; CODE & concat _STRING
VAR	ANON_451_15_L176_G_data, Q
VAR	ANON_451_15_L176_G_info, Q
VAR	ANON_451_63_L176_D_data, Q
VAR	ANON_451_63_L176_D_info, Q
VAR	ANON_451_15_L176_G_len,  Q
VAR	ANON_451_63_L176_D_len,  Q
VAR	ANON_451_15_L176_R_disp, Q
VAR	ANON_451_15_L176_R__u,   Q
namespace ANON_451_15_L176_R_info
  VAR SIZ__, D
  VAR _COMP_SIZ, D
  VAR _FST_1, D
  VAR _LST_1, D
end namespace
STR ANON_451_15_L176_G, "!! IL N Y A PAS DE LISTE ASSOCIEE AU NOEUD "	; constante string="!! IL N Y A PAS DE LISTE ASSOCIEE AU NOEUD "
	LCA	ANON_451_15_L176_G.data_ptr
	DUP
	LA  ,  0
	SA  1, ANON_451_15_L176_G_data
	LA  ,  8
	SA  1, ANON_451_15_L176_G_info
	LID 1, ANON_451_15_L176_G_info, _STRING.LST_1
	LID 1, ANON_451_15_L176_G_info, _STRING.FST_1
	SUB
	INC
	CLAMP0
	SA  1, ANON_451_15_L176_G_len
VAR	ANON_451_63_disp, Q
VAR	ANON_451_63__u,   Q
namespace ANON_451_63_info
  VAR SIZ__, D
  VAR _COMP_SIZ, D
  VAR _FST_1, D
  VAR _LST_1, D
end namespace
	LVA 1, ANON_451_63_info.SIZ__
	SA  1, ANON_451_63__u
	LVA 1, ANON_451_63_disp
	LA  1,	-T_ofs
	CALL	STANDARD.IDL.IDL_MAN. ,NODE_REP_L51
	DUP
	LA  ,  0
	SA  1, ANON_451_63_L176_D_data
	LA  ,  8
	SA  1, ANON_451_63_L176_D_info
	LID 1, ANON_451_63_L176_D_info, _STRING.LST_1
	LID 1, ANON_451_63_L176_D_info, _STRING.FST_1
	SUB
	INC
	CLAMP0
	SA  1, ANON_451_63_L176_D_len
	LA  1, ANON_451_15_L176_G_len
	LA  1, ANON_451_63_L176_D_len
	ADD
	CO_VAR
	SA  1, ANON_451_15_L176_R_disp
	LI	1
	SD  1, ANON_451_15_L176_R_info._FST_1
	LA  1, ANON_451_15_L176_G_len
	LA  1, ANON_451_63_L176_D_len
	ADD
	SD  1, ANON_451_15_L176_R_info._LST_1
	LI	8
	SD  1, ANON_451_15_L176_R_info._COMP_SIZ
	LA  1, ANON_451_15_L176_G_len
	LA  1, ANON_451_63_L176_D_len
	ADD
	LI	8
	MUL
	SD  1, ANON_451_15_L176_R_info.SIZ__
	LVA 1, ANON_451_15_L176_R_info.SIZ__
	SA  1, ANON_451_15_L176_R__u
	LA  1, ANON_451_15_L176_R_disp
	LA  1, ANON_451_15_L176_G_len
	LA  1, ANON_451_15_L176_G_data
	BLKMOV
	LA  1, ANON_451_15_L176_R_disp
	LA  1, ANON_451_15_L176_G_len
	ADD
	LA  1, ANON_451_63_L176_D_len
	LA  1, ANON_451_63_L176_D_data
	BLKMOV
	LVA 1, ANON_451_15_L176_R_disp
	CALL	STANDARD.TEXT_IO. ,PUT_LINE_L60
	LCA	STANDARD.PROGRAM_ERROR__exc.data_ptr
	SA	0, STANDARD.EXCEPTIONS_CURRENT_disp
	BRA	STANDARD.exc_raise_
ret_lbl:
	UNLINKR 1
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO LIST
