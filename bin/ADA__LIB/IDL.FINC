	LID	2, STANDARD.IDL.DI_L20.INTEGER_OVER_SHORT.DD__u, STANDARD.IDL.DI_L20.INTEGER_OVER_SHORT._DOUBLET.FST_1	; (index - FST_1) * SIZ_1
	SUB
