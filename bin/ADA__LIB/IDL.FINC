 hexa_show ' disp ', T_disp
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	IL72_disp, B				; compteur boucle LOOP__5
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SB  2,	IL72_disp
VAR	LMT_IL72_disp, B			; limite boucle LOOP__5
	LI	 127
	SB  2,	LMT_IL72_disp
	ULB  2,	IL72_disp				; test null range LOOP__5
	ULB  2,	LMT_IL72_disp
	CGT
	BT	L71
LOOP__5:					; corps boucle LOOP__5
	LVA  0,	STANDARD.IDL.TREE_NIL_disp		; array actual
	LVA 2,	T_disp
	ULB  2,	IL72_disp
	DUP
	ULB	0, STANDARD.IDL._ATTR_NBR.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULB	0, STANDARD.IDL._ATTR_NBR.LST
	CGT
	BT	STANDARD.ce_raise_
	CALL	STANDARD.IDL.IDL_MAN. ,DABS_L37
	ULB  2,	IL72_disp				; test de sortie LOOP__5
	ULB  2,	LMT_IL72_disp
	CEQ
	BT	L71
	ULB  2,	IL72_disp				; mise a jour compteur LOOP__5
	INC
	SB  2,	IL72_disp
	BRA	LOOP__5				; iteration suivante LOOP__5
L71:					; post loop LOOP__5
	UNLINKR 2
endPRO
