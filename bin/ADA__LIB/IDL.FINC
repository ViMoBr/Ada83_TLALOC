	BT	STANDARD.ne_raise_
	DIV
	SD  2,	Q_disp
	LA	 2, STANDARD.IDL.DI_L20.INTEGER_OVER_SHORT.DD_disp	; array data start address on stack
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	DUP
	LID	2, STANDARD.IDL.DI_L20.INTEGER_OVER_SHORT.DD__u, STANDARD.IDL.DI_L20.INTEGER_OVER_SHORT._DOUBLET.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LID	2, STANDARD.IDL.DI_L20.INTEGER_OVER_SHORT.DD__u, STANDARD.IDL.DI_L20.INTEGER_OVER_SHORT._DOUBLET.LST_1
	CGT
