_PROJECT_PATH__type = '_PROJECT_PATH__type'
namespace _PROJECT_PATH__type			; array var constrained array type info
VAR use__info, Q
VAR SIZ__, D
	LVA	0, SIZ__
	SA	0, use__info
VAR _COMP_SIZ, D
VAR _FST_1, D
VAR _LST_1, D
	LI	8
	SD	0, _COMP_SIZ
	LD	0, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SD	0, _FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	256
	SD	0, _LST_1
	LD	0, _LST_1
	LD	0, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	SD	0, SIZ__
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
