LOOP__9:					; corps boucle LOOP__9
	LA	 2, STANDARD.IDL.DI_L20.INTEGER_OVER_SHORT.DD_disp	; array data start address on stack
; CODE_NUMERIC_LITERAL DN_INTEGER
