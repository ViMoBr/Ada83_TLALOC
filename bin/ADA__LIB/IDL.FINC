 hexa_show ' spec ', $

					; _NODE_SPECIF RECORD TYPE INFO
_NODE_SPECIF = '_NODE_SPECIF'
namespace _NODE_SPECIF
VAR use__info, Q
VAR SIZ__, D
	LVA	0, SIZ__
	SA	0, use__info
USEINFO 0, NS_SIZE, 	LA 0, STANDARD.IDL._ATTR_NBR.use__info
USEINFO 0, NS_FIRST_A, 	LA 0, STANDARD._INTEGER.use__info
USEINFO 0, NS_ARITY, 	LA 0, STANDARD.IDL.IDL_MAN._ARITIES.use__info
virtual at 0				; calcul des offsets statiques
STATOFS NS_SIZE, 1, 1
STATOFS NS_FIRST_A, 4, 4
STATOFS NS_ARITY, 1, 1
size = $
end virtual
	LI	 size*8
	SD	0, SIZ__
end namespace

					; array decl constrained array type info
_NODE_SPECIF_TABLE = '_NODE_SPECIF_TABLE'
namespace _NODE_SPECIF_TABLE
VAR use__info, Q
VAR SIZ__, D
	LVA	0, SIZ__
	SA	0, use__info
VAR _COMP_SIZ, D
VAR _FST_1, D
VAR _LST_1, D
	LI	72
	SD	0, _COMP_SIZ
	LD	0, _COMP_SIZ
	LI	0
	SD	0, _FST_1
	LI	231
	SD	0, _LST_1
	LD	0, _LST_1
	LD	0, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	SD	0, SIZ__
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace

					; _ATTR_SPECIF RECORD TYPE INFO
_ATTR_SPECIF = '_ATTR_SPECIF'
namespace _ATTR_SPECIF
VAR use__info, Q
VAR SIZ__, D
	LVA	0, SIZ__
	SA	0, use__info
USEINFO 0, ATTR, 	LA 0, STANDARD.DIANA_NODE_ATTR_CLASS_NAMES._ATTRIBUTE_NAME.use__info
USEINFO 0, IS_LIST, 	LA 0, STANDARD._BOOLEAN.use__info
virtual at 0				; calcul des offsets statiques
STATOFS ATTR, 1, 1
STATOFS IS_LIST, 1, 1
size = $
end virtual
	LI	 size*8
	SD	0, SIZ__
end namespace

					; array decl constrained array type info
_ATTR_ID_TABLE = '_ATTR_ID_TABLE'
namespace _ATTR_ID_TABLE
VAR use__info, Q
