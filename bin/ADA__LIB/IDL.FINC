	LID	2, STANDARD.IDL.DI_L20.INTEGER_OVER_SHORT.DD__u, STANDARD.IDL.DI_L20.INTEGER_OVER_SHORT._DOUBLET.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LID	2, STANDARD.IDL.DI_L20.INTEGER_OVER_SHORT.DD__u, STANDARD.IDL.DI_L20.INTEGER_OVER_SHORT._DOUBLET.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LD 2,	Q_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10000
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	MODI
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
	SW
	LD 2,	Q_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10000
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	SD  2,	Q_disp
