_SEQ_TYPE = '_SEQ_TYPE'
namespace _SEQ_TYPE
VAR use__info, Q
VAR SIZ__, D
	LVA	0, SIZ__
	SA	0, use__info
USEINFO 0, FIRST, 	LA 0, STANDARD.IDL._TREE.use__info
USEINFO 0, NEXT, 	LA 0, STANDARD.IDL._TREE.use__info
virtual at 0				; calcul des offsets statiques
STATOFS FIRST, 4, 8
STATOFS NEXT, 4, 8
size = $
end virtual
	LI	 size*8
	SD	0, SIZ__
end namespace
