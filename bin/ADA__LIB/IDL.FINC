USEINFO 0, TB_A_SPEC, 	LA 0, STANDARD.IDL.IDL_TBL._ATTR_ID_TABLE.use__info
virtual at 0				; calcul des offsets statiques
STATOFS TB_LAST_NODE, 4, 4
