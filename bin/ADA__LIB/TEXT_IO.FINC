	ADD					; add offset to start address
	ULB
	SB  2,	CH_disp
					; debut if
	ULB  1,	-SET_ofs
	LI	0
	CEQ
	BF	L1445
					; debut if
	ULB 2,	CH_disp
	LI	65
	CGE
	DUP
	BF	L1448
	DROP
	ULB 2,	CH_disp
	LI	90
	CLE
L1448:
	BF	L1447
	ULB 2,	CH_disp
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	32
	ADD
	SB  2,	CH_disp
	BRA	L1446
L1447:
L1446:					; post if
	BRA	L1444
L1445:
L1444:					; post if
	LVA	1, -TO_ofs
	LIA	, , 0				; array data start address on stack
	LD 2,	DST_disp
	LD 2,	JL1443_disp
	ADD
	DUP
	LVA	1, -TO_ofs
	LIA	, 0,  8
	LD	, STANDARD._STRING.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LVA	1, -TO_ofs
	LIA	, 0,  8
	LD	, STANDARD._STRING.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LVA	1, -TO_ofs
	LIA	, 0,  8
	LD	, STANDARD._STRING.FST_1			; (index - FST_1) * SIZ_1
	SUB
	LVA	1, -TO_ofs
	LIA	, , 8
	LD	, STANDARD._STRING.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	ULB 2,	CH_disp
	SB
	LD  2,	JL1443_disp				; test de sortie LOOP__118
	LD  2,	LMT_JL1443_disp
	CEQ
	BT	L1442
	LD  2,	JL1443_disp				; mise a jour compteur LOOP__118
	INC
	SD  2,	JL1443_disp
	BRA	LOOP__118				; iteration suivante LOOP__118
L1442:					; post loop LOOP__118
	UNLINK 2
	BRA ret_lbl
	BRA	L1438
L1439:
L1438:					; post if
	LD 2,	I_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	ADD
	LD 2,	LEN_disp
	ADD
	DUP
	LD	0, STANDARD._POSITIVE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD._POSITIVE.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  2,	I_disp
	BRA	LOOP__117
L1437:					; post loop LOOP__117
	LCA	STANDARD.PROGRAM_ERROR__exc.data_ptr
	SA	0, STANDARD.EXCEPTIONS_CURRENT_disp
	BRA	STANDARD.exc_raise_
	UNLINK 2
endPRO
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO PUT
end if
