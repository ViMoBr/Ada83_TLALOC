	LIA	, 0,  8
	LD	, STANDARD._STRING.FST_1			; (index - FST_1) * SIZ_1
	SUB
	LVA	1, -ITEM_ofs
	LIA	, , 8
	LD	, STANDARD._STRING.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LA  1,	-FILE_ofs
	CALL	STANDARD.TEXT_IO. ,GET_L49
	LD  1,	IL322_disp				; test de sortie LOOP__7
	LD  1,	LMT_IL322_disp
	CEQ
	BT	L321
	LD  1,	IL322_disp				; mise a jour compteur LOOP__7
	INC
	SD  1,	IL322_disp
	BRA	LOOP__7				; iteration suivante LOOP__7
L321:					; post loop LOOP__7
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
