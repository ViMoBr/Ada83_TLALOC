if defined GET_L74_
PRO	GET_L74				;---------- PRO GET
 hexa_show 'GET_L74 ', $
PRMS					;    debut parametrage
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
	PRM GFP_ofs
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LA  1,	-GFP_ofs				; propagation GFP generique
	LD  1,	-WIDTH_ofs
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	LA  1,	-ITEM_ofs
	LVA 0,	STANDARD.TEXT_IO.DEFAULT_INPUT_disp
	CALL	STANDARD.TEXT_IO.FIXED_IO. ,GET_L73
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO GET
end if

if defined PUT_L75_
PRO	PUT_L75				;---------- PRO PUT
