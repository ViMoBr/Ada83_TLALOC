	SD  2,	EVAL_disp

 hexa_show ' disp ', EVAL_disp
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
VAR	IL695_disp, D				; compteur boucle LOOP__31
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SD  2,	IL695_disp
VAR	LMT_IL695_disp, D			; limite boucle LOOP__31
	LD  1,	-EXP_ofs
	SD  2,	LMT_IL695_disp
	LD  2,	IL695_disp				; test null range LOOP__31
	LD  2,	LMT_IL695_disp
	CGT
	BT	L694
	LD  2,	IL695_disp				; inversion range LOOP__31
	LD  2,	LMT_IL695_disp
	SD  2,	IL695_disp
	SD  2,	LMT_IL695_disp
LOOP__31:					; corps boucle LOOP__31
	LA	 2, STANDARD.TEXT_IO.FLOAT_IO.PUT_L69.BLOCK__29.EXP_STR_disp	; array data start address on stack
	LD 2,	IL695_disp
	DUP
	LID	2, STANDARD.TEXT_IO.FLOAT_IO.PUT_L69.BLOCK__29.EXP_STR__u, STANDARD._STRING.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LID	2, STANDARD.TEXT_IO.FLOAT_IO.PUT_L69.BLOCK__29.EXP_STR__u, STANDARD._STRING.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LID	2, STANDARD.TEXT_IO.FLOAT_IO.PUT_L69.BLOCK__29.EXP_STR__u, STANDARD._STRING.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LID	2, STANDARD.TEXT_IO.FLOAT_IO.PUT_L69.BLOCK__29.EXP_STR__u, STANDARD._STRING.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	LI	48
	LD 2,	EVAL_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	MODI
	ADD
	SB
	LD 2,	EVAL_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10
	DUP
	LI	0
	CEQ
	BT	STANDARD.ne_raise_
	DIV
	SD  2,	EVAL_disp
	LD  2,	IL695_disp				; test de sortie LOOP__31
	LD  2,	LMT_IL695_disp
	CEQ
	BT	L694
	LD  2,	IL695_disp				; mise a jour compteur LOOP__31
	DEC
	SD  2,	IL695_disp
	BRA	LOOP__31				; iteration suivante LOOP__31
L694:					; post loop LOOP__31
	LVA 2,	EXP_STR_disp
	LA  1,	-FILE_ofs
	CALL	STANDARD.TEXT_IO. ,PUT_L55
	UNLINK 2
endPRO
	BRA	L688
L689:
L688:					; post if
ret_lbl:
	UNLINK 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO PUT
end if

