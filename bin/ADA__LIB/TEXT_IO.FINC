	FMUL
	LA 1,	-GFP_ofs
	LIQ , -NUM__u_ofs, STANDARD._FIXED_USE_INFO.DENOM
	CVTIF
	FDIV
	SQ  1,	VAL_disp

 hexa_show ' disp ', VAL_disp
 hexa_show 'var elab IS_NEGATIVE ', $
VAR IS_NEGATIVE_disp, B			; variable bool char enum
