	LI	0
	SB
	LIVA 1, STANDARD.IDL.IDL_TBL.WRITE_SPEC_L54.SFILE_disp, STANDARD.IDL.IDL_TBL.DTT_IO._FILE_TYPE.AT_END_OF_FILE
	LI	0
	SB

 hexa_show ' disp ', SFILE_disp
					;    end elab
