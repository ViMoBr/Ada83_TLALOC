namespace ANON_140_35_L61_R_info
  VAR SIZ__, D
  VAR _COMP_SIZ, D
  VAR _FST_1, D
  VAR _LST_1, D
end namespace
	LA  1,	-SPEC_FILE_ofs
	DUP
	LA  ,  0
	SA  1, ANON_140_35_L61_G_data
	LA  ,  8
	SA  1, ANON_140_35_L61_G_info
