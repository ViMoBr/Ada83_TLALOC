; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	SID	0, 	STANDARD.IDL.IDL_TBL.LAST_NODE_ATTR_disp, 0
LOOP__1:
	LI	0					; lieu resultat sur pile
	LVA 1,	SFILE_disp
	CALL	STANDARD.TEXT_IO. ,END_OF_FILE_L37
	LI	1
	OUX
