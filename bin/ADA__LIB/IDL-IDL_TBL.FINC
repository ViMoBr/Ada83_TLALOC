	LID 1, ANON_140_35_L61_G_info, _STRING.FST_1
	SUB
	INC
	CLAMP0
	SA  1, ANON_140_35_L61_G_len
STR ANON_140_47_L61_D, ".bin"			; constante string=".bin"
	LCA	ANON_140_47_L61_D.data_ptr
	DUP
	LA  ,  0
	SA  1, ANON_140_47_L61_D_data
	LA  ,  8
	SA  1, ANON_140_47_L61_D_info
	LID 1, ANON_140_47_L61_D_info, _STRING.LST_1
	LID 1, ANON_140_47_L61_D_info, _STRING.FST_1
	SUB
	INC
	CLAMP0
	SA  1, ANON_140_47_L61_D_len
	LA  1, ANON_140_35_L61_G_len
	LA  1, ANON_140_47_L61_D_len
	ADD
	CO_VAR
	SA  1, ANON_140_35_L61_R_disp
	LI	1
	SD  1, ANON_140_35_L61_R_info._FST_1
	LA  1, ANON_140_35_L61_G_len
	LA  1, ANON_140_47_L61_D_len
	ADD
	SD  1, ANON_140_35_L61_R_info._LST_1
	LI	8
	SD  1, ANON_140_35_L61_R_info._COMP_SIZ
	LA  1, ANON_140_35_L61_G_len
	LA  1, ANON_140_47_L61_D_len
	ADD
	LI	8
	MUL
	SD  1, ANON_140_35_L61_R_info.SIZ__
	LVA 1, ANON_140_35_L61_R_info.SIZ__
	SA  1, ANON_140_35_L61_R__u
	LA  1, ANON_140_35_L61_R_disp
	LA  1, ANON_140_35_L61_G_len
	LA  1, ANON_140_35_L61_G_data
	BLKMOV
	LA  1, ANON_140_35_L61_R_disp
	LA  1, ANON_140_35_L61_G_len
	ADD
	LA  1, ANON_140_47_L61_D_len
	LA  1, ANON_140_47_L61_D_data
	BLKMOV
	LVA 1, ANON_140_35_L61_R_disp
	LI  1
	LVA  1,	STANDARD.IDL.IDL_TBL.WRITE_SPEC_L54.SFILE_disp
