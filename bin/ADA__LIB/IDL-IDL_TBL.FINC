 hexa_show 'var elab T_TXT ', $
_T_TXT__type = '_T_TXT__type'
namespace _T_TXT__type			; array var constrained array type info
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
VAR _COMP_SIZ, D
VAR _FST_1, D
VAR _LST_1, D
	LI	8
	SD	1, _COMP_SIZ
	LD	1, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SD	1, _FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	50
	SD	1, _LST_1
	LD	1, _LST_1
	LD	1, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	SD	1, SIZ__
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR T_TXT_disp, Q				; variable array : pointeur aux data
VAR T_TXT__u, Q				; variable array : useinfo pointeur au rec info
	LA 1, _T_TXT__type.use__info
	SA	1, T_TXT__u				; array info ptr at __u
	LD	1, _T_TXT__type.SIZ__
	LI	8
	DIV
	CO_VAR
	SA	1, T_TXT_disp				; array data ptr at _disp

 hexa_show ' disp ', T_TXT_disp
