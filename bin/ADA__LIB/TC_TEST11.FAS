	include '../../src/expander/fasmg/codi_x86_64.finc'
STANDARD = 'STANDARD'
namespace STANDARD
  virtual at 8
    VARzone::
  end virtual
	LINK	0, loc_siz
_EXCEPTION_CONTEXT = '_EXCEPTION_CONTEXT'
 namespace _EXCEPTION_CONTEXT
virtual at 0
	STATOFS	PREV_CTX, 8, 8
	STATOFS	DISPATCH, 8, 8
end virtual
end namespace 
	VAR	EXC_CTX0__dat, 64
	VAR	EXCEPTIONS_TOP_CTX_disp, Q
	VAR	EXCEPTIONS_CURRENT_disp, Q
	EXC_MACH	0, EXC_CTX0__dat
	LCA	exc_uncaught_
	SA	0, EXC_CTX0__dat + _EXCEPTION_CONTEXT.DISPATCH
	LVA	0, EXC_CTX0__dat
	SA	0, EXCEPTIONS_TOP_CTX_disp
	BRA	ce_raise_
	SYS_EXIT
exc_raise_:
	EXC_RAISE	EXCEPTIONS_TOP_CTX_disp
exc_uncaught_:
	STR	EXC_MSG__, 'EXCEPTION NON RATTRAPEE : '
	STR	EXC_NL__, 10
	LCA	EXC_MSG__.data_ptr
	SYS_PUT_STR
	LA	0, EXCEPTIONS_CURRENT_disp
	SYS_PUT_STR
	LCA	EXC_NL__.data_ptr
	SYS_PUT_STR
	SYS_EXIT	1
ce_raise_:
	LCA	CONSTRAINT_ERROR__exc.data_ptr
	SA	0, EXCEPTIONS_CURRENT_disp
	BRA	exc_raise_
ne_raise_:
	LCA	NUMERIC_ERROR__exc.data_ptr
	SA	0, EXCEPTIONS_CURRENT_disp
	BRA	exc_raise_
	STR	CONSTRAINT_ERROR__exc, 'CONSTRAINT_ERROR'
	STR	NUMERIC_ERROR__exc, 'NUMERIC_ERROR'
 virtual VARzone
   loc_siz = $
  end virtual
end namespace
