	SA	1, ANON_128_37_disp
	LVA	1, SIZ__
	SA	1, ANON_128_37__u
	LI	8
	SD	1, COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SD	1, _FST_1
	LA 1, -FILE_ofs
	LID	, 0, STANDARD.DIRECT_IO._FILE_TYPE.NAME_LEN
	SD	1, _LST_1
	LD	1, _LST_1
	LD	1, _FST_1
	SUB
	INC
	CLAMP0
	LI	8
	MUL
	SD	1, SIZ__
	LVA	1, ANON_128_37_disp
end namespace
