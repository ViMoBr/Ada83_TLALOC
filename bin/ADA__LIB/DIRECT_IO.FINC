namespace ANON_128_37			; ensemble doublet @data/@info pour slice anonyme source
VAR ANON_128_37_disp, Q
VAR ANON_128_37__u, Q
VAR SIZ__, D
VAR COMP_SIZ, D
VAR _FST_1, D
