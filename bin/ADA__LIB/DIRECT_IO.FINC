					;    BODY ELAB

if defined CREATE_L1_
PRO	CREATE_L1				;---------- PRO CREATE
 hexa_show 'CREATE_L1 ', $
PRMS					;    debut parametrage
	PRM FILE_ofs				; in out
	PRM MODE_ofs				; in
	PRM NAME_ofs				; in
	PRM FORM_ofs				; in
	PRM GFP_ofs
endPRMS					;    fin parametrage
ELB 1					;    BODY ELAB
 hexa_show 'var elab ERR_OR_ID ', $
VAR ERR_OR_ID_disp, D			; variable entiere

 hexa_show ' disp ', ERR_OR_ID_disp

if defined CREATE_SYSTEM_CALL_L1_
PRO	CREATE_SYSTEM_CALL_L1			;---------- PRO CREATE_SYSTEM_CALL
 hexa_show 'CREATE_SYSTEM_CALL_L1 ', $
PRMS					;    debut parametrage
	PRM NAME_ofs				; in
	PRM GFP_ofs
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LA 2 ,	-8
	SYS_FILE_CREATE
	SD 2 ,	-24
ret_lbl:
	UNLINKR 2
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO CREATE_SYSTEM_CALL
end if
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LI	0					; lieu resultat sur pile
	LA  1,	-GFP_ofs				; propagation GFP generique
	LA  1,	-NAME_ofs
	CALL	STANDARD.DIRECT_IO.CREATE_L1. ,CREATE_SYSTEM_CALL_L1
	SD  1,	ERR_OR_ID_disp
					; debut if
	LD 1,	ERR_OR_ID_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	CGE
	BF	L7
	LA 1, -FILE_ofs
	LIVA 	, 0, STANDARD.DIRECT_IO._FILE_TYPE.ID
	LD 1,	ERR_OR_ID_disp
	SD
	LA 1, -FILE_ofs
	LIVA 	, 0, STANDARD.DIRECT_IO._FILE_TYPE.NAME
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	LD	 0, STANDARD.DIRECT_IO._FILE_NAME_BUFFER._FST_1
	SUB
	LI	1
	MUL
	ADD
	LVA	1, -NAME_ofs
	LIA	, , 8
	LD	, _STRING.LST_1
	LVA	1, -NAME_ofs
	LIA	, , 8
	LD	, _STRING.FST_1
	SUB
	INC
	CLAMP0
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	INC
	CLAMP0
	LI	1
	MUL
	LA  1,	-NAME_ofs
	LA
	BLKMOV
	LA 1, -FILE_ofs
	LIVA 	, 0, STANDARD.DIRECT_IO._FILE_TYPE.NAME_LEN
	LVA	1, -NAME_ofs
	LIA	, , 8
	LD	, _STRING.LST_1
	LVA	1, -NAME_ofs
	LIA	, , 8
	LD	, _STRING.FST_1
	SUB
	INC
	CLAMP0
	SD
	LA 1, -FILE_ofs
	LIVA 	, 0, STANDARD.DIRECT_IO._FILE_TYPE.IS_OPENED
	LI	1
	SB
	LA 1, -FILE_ofs
	LIVA 	, 0, STANDARD.DIRECT_IO._FILE_TYPE.MODE
	ULB  1,	-MODE_ofs
	SB
	LA 1, -FILE_ofs
	LIVA 	, 0, STANDARD.DIRECT_IO._FILE_TYPE.INDEX
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SD
	LA 1, -FILE_ofs
	LIVA 	, 0, STANDARD.DIRECT_IO._FILE_TYPE.AT_END_OF_FILE
	LI	0
	SB
	BRA	L6
L7:
L6:					; post if
ret_lbl:
	UNLINKR 1
	RTD	prm_siz
excep:
endPRO					;---------- end PRO CREATE
end if

