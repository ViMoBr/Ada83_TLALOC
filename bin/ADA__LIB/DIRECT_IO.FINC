	ADD
; CODE CONVERSION SOURCE DN_INTEGER TARGET DN_INTEGER
	DUP
	ULD	0, STANDARD.DIRECT_IO._POSITIVE_COUNT.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	ULD	0, STANDARD.DIRECT_IO._POSITIVE_COUNT.LST
	CGT
	BT	STANDARD.ce_raise_
	DUP
	ULD	0, STANDARD.DIRECT_IO._POSITIVE_COUNT.FST
	CLT
