TARGET_CODE = 'TARGET_CODE'
PRO	TARGET_CODE_L1				;---------- PRO TARGET_CODE
 hexa_show 'TARGET_CODE_L1 ', $
ELB 1					;    BODY ELAB

					; _CPU_KIND ENUMERATION TYPE INFO
_CPU_KIND = '_CPU_KIND'
namespace _CPU_KIND
VAR use__info, Q
BEGIN_BLOC_DEF
db 0, 6, "X86_64"
db 1, 5, "ARM64"
db 2, 7, "RISCV64"
END_BLOC_DEF 8, 0, 2
	; SIZ en bits !
	LCA	SIZ
	SA	1, use__info
end namespace
 hexa_show 'var elab TARGET_CPU ', $
VAR TARGET_CPU_disp, B			; variable entiere
	LI	0
	SB  1,	TARGET_CPU_disp

 hexa_show ' disp ', TARGET_CPU_disp
 hexa_show 'var elab GENERATE_BINARY_MAP ', $
VAR GENERATE_BINARY_MAP_disp, B		; variable bool char enum
	LI	0
	SB  1,	GENERATE_BINARY_MAP_disp

 hexa_show ' disp ', GENERATE_BINARY_MAP_disp

					; _TARGET_TRAITS RECORD TYPE INFO
_TARGET_TRAITS = '_TARGET_TRAITS'
namespace _TARGET_TRAITS
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
USEINFO 1, E_MACHINE, 	LA 0, STANDARD._INTEGER.use__info
USEINFO 1, ORIG, 	LA 0, STANDARD._INTEGER.use__info
USEINFO 1, ENTRY_POINT, 	LA 0, STANDARD._INTEGER.use__info
USEINFO 1, PAD_BYTE, 	LA 0, STANDARD._INTEGER.use__info
USEINFO 1, CALL_FRAME, 	LA 0, STANDARD._INTEGER.use__info
USEINFO 1, MEMSZ_RESERVE, 	LA 0, STANDARD.TARGET_CODE_L1.SYMBOLS._VALUE_TYPE.use__info
USEINFO 1, PROLOGUE_SIZE, 	LA 0, STANDARD._INTEGER.use__info
USEINFO 1, BRA_SIZE, 	LA 0, STANDARD._INTEGER.use__info
virtual at 0				; calcul des offsets statiques
STATOFS E_MACHINE, 4, 4
STATOFS ORIG, 4, 4
STATOFS ENTRY_POINT, 4, 4
STATOFS PAD_BYTE, 4, 4
STATOFS CALL_FRAME, 4, 4
STATOFS MEMSZ_RESERVE, 8, 8
STATOFS PROLOGUE_SIZE, 4, 4
STATOFS BRA_SIZE, 4, 4
size = $
end virtual
	LI	 size*8
	SD	1, SIZ__
end namespace
