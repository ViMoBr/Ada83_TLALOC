 hexa_show 'CODI_NAME_L62 ', $
PRMS					;    debut parametrage
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
					; debut case
	ULB 1,	STANDARD.TARGET_CODE_L1.TARGET_CPU_disp
	DUP
	LI	0
	CEQ
	BT	L66
	DUP
	LI	1
	CEQ
	BT	L67
	DUP
	LI	2
	CEQ
	BT	L68
	DROP
	BRA	L65
L66:
	DROP
; CODE_RETURN : EXPR TYPE = DN_VOID  VUE COMPLETE = DN_VOID
STR RET_STR_L69, "x86_64.finc"		; constante string="x86_64.finc"
	LCA	RET_STR_L69.data_ptr
VAR	RET_INFO_L70, Q
	DUP
	LA  ,  0
	SIQ   2, -result__ofs,  0
	DUP
	LA  ,  8
	SA   2, RET_INFO_L70
	DROP
	LA   2, -result__ofs
	LA  ,  8
	LI	16
	LA   2, RET_INFO_L70
	BLKMOV
	BRA ret_lbl
	BRA	L65
L67:
	DROP
; CODE_RETURN : EXPR TYPE = DN_VOID  VUE COMPLETE = DN_VOID
STR RET_STR_L71, "arm64.finc"			; constante string="arm64.finc"
	LCA	RET_STR_L71.data_ptr
VAR	RET_INFO_L72, Q
	DUP
	LA  ,  0
	SIQ   2, -result__ofs,  0
	DUP
	LA  ,  8
	SA   2, RET_INFO_L72
	DROP
	LA   2, -result__ofs
	LA  ,  8
	LI	16
	LA   2, RET_INFO_L72
	BLKMOV
	BRA ret_lbl
	BRA	L65
L68:
	DROP
; CODE_RETURN : EXPR TYPE = DN_VOID  VUE COMPLETE = DN_VOID
STR RET_STR_L73, "riscv64.finc"		; constante string="riscv64.finc"
	LCA	RET_STR_L73.data_ptr
VAR	RET_INFO_L74, Q
	DUP
	LA  ,  0
	SIQ   2, -result__ofs,  0
	DUP
	LA  ,  8
	SA   2, RET_INFO_L74
	DROP
	LA   2, -result__ofs
	LA  ,  8
	LI	16
	LA   2, RET_INFO_L74
	BLKMOV
	BRA ret_lbl
	BRA	L65
L65:
					; fin case
ret_lbl:
	UNLINK 2
	RTD
excep:
endPRO					;---------- end PRO CODI_NAME
end if

