begin:					;---------- BDY INSTRUCTIONS
STR STR_L64, "NOM FICHIER .fas (sans extension, simple ret faire les tests) : "	; constante string="NOM FICHIER .fas (sans extension, simple ret faire les tests) : "
	LCA	STR_L64.data_ptr
	CALL	STANDARD.TEXT_IO. ,PUT_L56
namespace	BLOCK__1
ELB 2					;    BODY ELAB
 hexa_show 'var elab TAMPON ', $
_TAMPON__type = '_TAMPON__type'
namespace _TAMPON__type			; array var constrained array type info
VAR use__info, Q
VAR SIZ__, D
	LVA	2, SIZ__
	SA	2, use__info
VAR _COMP_SIZ, D
VAR _FST_1, D
VAR _LST_1, D
	LI	8
	SD	2, _COMP_SIZ
	LD	2, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SD	2, _FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	255
	SD	2, _LST_1
	LD	2, _LST_1
	LD	2, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	SD	2, SIZ__
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR TAMPON_disp, Q				; variable array : pointeur aux data
VAR TAMPON__u, Q				; variable array : useinfo pointeur au rec info
	LA 2, _TAMPON__type.use__info
	SA	2, TAMPON__u				; array info ptr at __u
	LD	2, _TAMPON__type.SIZ__
	LI	8
	DIV
	CO_VAR
	SA	2, TAMPON_disp				; array data ptr at _disp

 hexa_show ' disp ', TAMPON_disp
 hexa_show 'var elab LONGUEUR ', $
VAR LONGUEUR_disp, D			; variable entiere

 hexa_show ' disp ', LONGUEUR_disp
 hexa_show 'var elab F ', $
VAR F_disp, Q				; variable record : pointeur aux data record
VAR F__u, Q				; variable record : pointeur aux useinfo
VAR F__dat, STANDARD.TEXT_IO._FILE_TYPE.size
	LVA	2, F__dat
	SA	2, F_disp				; record fin
	LVA	2, STANDARD.TEXT_IO._FILE_TYPE.SIZ__
	SA	2, F__u
	LIVA 2, STANDARD.TARGET_CODE_L1.BLOCK__1.F_disp, STANDARD.TEXT_IO._FILE_TYPE.ID
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	NEG
	SD
	LIVA 2, STANDARD.TARGET_CODE_L1.BLOCK__1.F_disp, STANDARD.TEXT_IO._FILE_TYPE.IS_OPENED
	LI	0
	SB
	LIVA 2, STANDARD.TARGET_CODE_L1.BLOCK__1.F_disp, STANDARD.TEXT_IO._FILE_TYPE.PAGE_LENGTH
	ULD 0,	STANDARD.TEXT_IO.UNBOUNDED_disp
	SD
	LIVA 2, STANDARD.TARGET_CODE_L1.BLOCK__1.F_disp, STANDARD.TEXT_IO._FILE_TYPE.LINE_LENGTH
	ULD 0,	STANDARD.TEXT_IO.UNBOUNDED_disp
	SD
	LIVA 2, STANDARD.TARGET_CODE_L1.BLOCK__1.F_disp, STANDARD.TEXT_IO._FILE_TYPE.PAGE
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SD
	LIVA 2, STANDARD.TARGET_CODE_L1.BLOCK__1.F_disp, STANDARD.TEXT_IO._FILE_TYPE.LINE
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SD
	LIVA 2, STANDARD.TARGET_CODE_L1.BLOCK__1.F_disp, STANDARD.TEXT_IO._FILE_TYPE.COL
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SD
	LIVA 2, STANDARD.TARGET_CODE_L1.BLOCK__1.F_disp, STANDARD.TEXT_IO._FILE_TYPE.IS_DEFAULT_IO
	LI	0
	SB
	LIVA 2, STANDARD.TARGET_CODE_L1.BLOCK__1.F_disp, STANDARD.TEXT_IO._FILE_TYPE.LOOK_AHEAD
	LI	 0
	SB
	LIVA 2, STANDARD.TARGET_CODE_L1.BLOCK__1.F_disp, STANDARD.TEXT_IO._FILE_TYPE.HAS_LOOK_AHEAD
	LI	0
	SB
	LIVA 2, STANDARD.TARGET_CODE_L1.BLOCK__1.F_disp, STANDARD.TEXT_IO._FILE_TYPE.AT_END_OF_FILE
	LI	0
	SB

 hexa_show ' disp ', F_disp
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LVA  2,	STANDARD.TARGET_CODE_L1.BLOCK__1.LONGUEUR_disp
	LVA  2,	STANDARD.TARGET_CODE_L1.BLOCK__1.TAMPON_disp
	CALL	STANDARD.TEXT_IO. ,GET_LINE_L58
