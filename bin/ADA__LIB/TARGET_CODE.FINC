_SLICE = '_SLICE'
namespace _SLICE
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
USEINFO 1, F, 	LA 0, STANDARD._NATURAL.use__info
USEINFO 1, L, 	LA 0, STANDARD._NATURAL.use__info
virtual at 0				; calcul des offsets statiques
STATOFS F, 4, 4
STATOFS L, 4, 4
size = $
end virtual
	LI	 size*8
	SD	1, SIZ__
end namespace
