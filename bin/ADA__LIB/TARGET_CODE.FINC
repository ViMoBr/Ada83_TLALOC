begin:					;---------- BDY INSTRUCTIONS
namespace	BLOCK__1
ELB 2					;    BODY ELAB
 hexa_show 'var elab TAMPON ', $
_TAMPON__type = '_TAMPON__type'
namespace _TAMPON__type			; array var constrained array type info
VAR use__info, Q
VAR SIZ__, D
	LVA	2, SIZ__
	SA	2, use__info
VAR _COMP_SIZ, D
VAR _FST_1, D
VAR _LST_1, D
	LI	8
	SD	2, _COMP_SIZ
	LD	2, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SD	2, _FST_1
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	32
	SD	2, _LST_1
	LD	2, _LST_1
	LD	2, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	SD	2, SIZ__
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR TAMPON_disp, Q				; variable array : pointeur aux data
VAR TAMPON__u, Q				; variable array : useinfo pointeur au rec info
	LA 2, _TAMPON__type.use__info
	SA	2, TAMPON__u				; array info ptr at __u
	LD	2, _TAMPON__type.SIZ__
	LI	8
	DIV
	CO_VAR
	SA	2, TAMPON_disp				; array data ptr at _disp

 hexa_show ' disp ', TAMPON_disp
 hexa_show 'var elab LONGUEUR ', $
VAR LONGUEUR_disp, D			; variable entiere

 hexa_show ' disp ', LONGUEUR_disp
CPU_KIND_IO = 'CPU_KIND_IO'
namespace CPU_KIND_IO			;---------- GENERIC PACKAGE INSTANTIATION
elab_spec:				;    SPEC ELAB

; F4A SET  cle=ENUM  actuel=DN_ENUMERATION
BRA post_LD_ENUM
LD_ENUM.elab:
	ULB -1, 0
	RTD 0
post_LD_ENUM:
BRA post_ST_ENUM
ST_ENUM.elab:
	SB -1, 0
	RTD 0
post_ST_ENUM:
BRA post_INADR_ENUM
INADR_ENUM.elab:
	RTD 0
post_INADR_ENUM:
BRA post_OUTADR_ENUM
OUTADR_ENUM.elab:
	LA
	RTD 0
post_OUTADR_ENUM:
VAR ENUM__outadr_ofs, Q
	LCA OUTADR_ENUM.elab
	SA	 2, ENUM__outadr_ofs
VAR ENUM__inadr_ofs, Q
	LCA INADR_ENUM.elab
	SA	 2, ENUM__inadr_ofs
VAR ENUM__st_ofs, Q
	LCA ST_ENUM.elab
	SA	 2, ENUM__st_ofs
VAR ENUM__ld_ofs, Q
	LCA LD_ENUM.elab
	SA	 2, ENUM__ld_ofs
VAR ENUM__u_ofs, Q
	LA	 1, STANDARD.TARGET_CODE_L1._CPU_KIND.use__info
	SA	 2, ENUM__u_ofs
VAR GFP_disp, Q				; Lieu du Generic Frame Pointer 
					; CODE_PACKAGE_SPEC
 hexa_show ' spec ', $
 hexa_show 'var elab DEFAULT_WIDTH ', $
VAR DEFAULT_WIDTH_disp, D			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.LST
