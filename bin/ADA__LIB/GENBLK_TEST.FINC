begin:					;---------- BDY INSTRUCTIONS
namespace	BLOCK__3
ELB 3					;    BODY ELAB
 hexa_show 'var elab K ', $
VAR K_disp, Q				; variable flottante
; CODE_NUMERIC_LITERAL DN_FLOAT
	LIF	3.0
	SQ  3,	K_disp

 hexa_show ' disp ', K_disp
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LA  2,	-GFP_ofs				; propagation GFP generique
	LQ 3,	K_disp
	LVA  2,	STANDARD.GENBLK_TEST_L1.GEN_PKG.CALL_IN_BLOCK_L11.R_disp
	CALL	STANDARD.GENBLK_TEST_L1.GEN_PKG. ,SCALE_L10
	UNLINK 3
endPRO
; CODE_RETURN : EXPR TYPE = DN_FLOAT  VUE COMPLETE = DN_FLOAT
	LVA 2,	R_disp
	LA 2,	-GFP_ofs
	LA ,	-NUM__inadr_ofs
	CALLI
	LA 2,	-GFP_ofs
	LA ,	-NUM__ld_ofs
	CALLI
	SQ  2,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 2
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO CALL_IN_BLOCK
end if
begin:					;---------- package BDY INSTRUCTIONS
end namespace 				;---------- end generic package BDY GEN_PKG
