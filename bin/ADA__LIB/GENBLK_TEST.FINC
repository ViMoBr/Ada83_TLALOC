GENBLK_TEST = 'GENBLK_TEST'
PRO	GENBLK_TEST_L1				;---------- PRO GENBLK_TEST
 hexa_show 'GENBLK_TEST_L1 ', $
ELB 1					;    BODY ELAB
 hexa_show 'var elab NB_OK ', $
VAR NB_OK_disp, D				; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	0
	SD  1,	NB_OK_disp

 hexa_show ' disp ', NB_OK_disp
 hexa_show 'var elab NB_ECHECS ', $
VAR NB_ECHECS_disp, D			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
