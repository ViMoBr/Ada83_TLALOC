	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB

if defined TWICE_L16_
PRO	TWICE_L16				;---------- PRO TWICE
 hexa_show 'TWICE_L16 ', $
PRMS					;    debut parametrage
	PRM V_ofs				; in
	PRM GFP_ofs
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 3					;    BODY ELAB
 hexa_show 'var elab W ', $
VAR W_disp, Q				; variable flottante
	LVA  3,	-V_ofs
	LA 2,	-GFP_ofs
	LA ,	-NUM__inadr_ofs
	CALLI
	LA  2,	-GFP_ofs
	LA ,	-NUM__ld_ofs
	CALLI
	SQ  3,	W_disp

 hexa_show ' disp ', W_disp
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
namespace	BLOCK__2
ELB 4					;    BODY ELAB
 hexa_show 'var elab Z ', $
VAR Z_disp, Q				; variable flottante
; CODE_NUMERIC_LITERAL DN_FLOAT
	LIF	2.0
	SQ  4,	Z_disp

 hexa_show ' disp ', Z_disp
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LVA 3,	STANDARD.GENBLK_TEST_L1.GEN_PKG.NESTED_L9.TWICE_L16.W_disp
	LA 3,	-GFP_ofs
	LA ,	-NUM__inadr_ofs
	CALLI
	LA 3,	-GFP_ofs
	LA ,	-NUM__ld_ofs
	CALLI
	LVA 4,	Z_disp
	LA 3,	-GFP_ofs
	LA ,	-NUM__inadr_ofs
	CALLI
	LA 3,	-GFP_ofs
	LA ,	-NUM__ld_ofs
	CALLI
	FMUL
	SQ  3,	STANDARD.GENBLK_TEST_L1.GEN_PKG.NESTED_L9.TWICE_L16.W_disp
	UNLINK 4
endPRO
; CODE_RETURN : EXPR TYPE = DN_FLOAT  VUE COMPLETE = DN_FLOAT
	LVA 3,	W_disp
	LA 3,	-GFP_ofs
	LA ,	-NUM__inadr_ofs
	CALLI
	LA 3,	-GFP_ofs
	LA ,	-NUM__ld_ofs
	CALLI
	SQ  3,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 3
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO TWICE
end if
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
; CODE_RETURN : EXPR TYPE = DN_FLOAT  VUE COMPLETE = DN_FLOAT
	LI	0					; lieu resultat sur pile
	LA  2,	-GFP_ofs				; propagation GFP generique
	LVA 2,	-A_ofs
	LA 2,	-GFP_ofs
	LA ,	-NUM__ld_ofs
	CALLI
	CALL	STANDARD.GENBLK_TEST_L1.GEN_PKG.NESTED_L9. ,TWICE_L16
	SQ  2,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 2
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO NESTED
end if

if defined SCALE_L10_
PRO	SCALE_L10				;---------- PRO SCALE
 hexa_show 'SCALE_L10 ', $
PRMS					;    debut parametrage
	PRM X_ofs				; in out
	PRM K_ofs				; in
	PRM GFP_ofs
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LVA  2,	-X_ofs
	LA
	LVA  2,	-X_ofs
	LA 2,	-GFP_ofs
	LA ,	-NUM__outadr_ofs
	CALLI
	LA  2,	-GFP_ofs
	LA ,	-NUM__ld_ofs
	CALLI
	LVA  2,	-K_ofs
	LA 2,	-GFP_ofs
	LA ,	-NUM__inadr_ofs
	CALLI
	LA  2,	-GFP_ofs
	LA ,	-NUM__ld_ofs
	CALLI
	FMUL
	LA  2,	-GFP_ofs
	LA ,	-NUM__st_ofs
	CALLI
ret_lbl:
	UNLINK 2
	RTD	prm_siz
excep:
endPRO					;---------- end PRO SCALE
end if

if defined CALL_IN_BLOCK_L11_
