GEN_PKG = 'GEN_PKG'
GEN_PKG = 'GEN_PKG'
namespace GEN_PKG
					;---------- GENERIC PACKAGE ----------

 hexa_show 'GEN_PKG body ', $
PRMS
	PRM NUM__u_ofs
	PRM NUM__ld_ofs
	PRM NUM__st_ofs
	PRM NUM__inadr_ofs
	PRM NUM__outadr_ofs
endPRMS

					;---------- GENERIC PACKAGE SPEC OF BODY ----------

					; CODE_PACKAGE_SPEC
 hexa_show ' spec ', $
					; sub program entry decl (in instantiation FALSE )
					; sub program entry decl (in instantiation FALSE )
					; sub program entry decl (in instantiation FALSE )
					; sub program entry decl (in instantiation FALSE )

					;---------- GENERIC PACKAGE BODY ----------

					;    BODY ELAB

if defined HALF_SUM_L8_
PRO	HALF_SUM_L8				;---------- PRO HALF_SUM
 hexa_show 'HALF_SUM_L8 ', $
PRMS					;    debut parametrage
	PRM A_ofs				; in
	PRM B_ofs				; in
	PRM GFP_ofs
	PRM result__ofs				; resultat de fonction
endPRMS					;    fin parametrage
ELB 2					;    BODY ELAB
 hexa_show 'var elab R ', $
VAR R_disp, Q				; variable flottante
	LVA  2,	-A_ofs
	LA 2,	-GFP_ofs
	LA ,	-NUM__inadr_ofs
	CALLI
	LA  2,	-GFP_ofs
	LA ,	-NUM__ld_ofs
	CALLI
	SQ  2,	R_disp

 hexa_show ' disp ', R_disp
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
namespace	BLOCK__1
ELB 3					;    BODY ELAB
 hexa_show 'var elab H ', $
VAR H_disp, Q				; variable flottante
; CODE_NUMERIC_LITERAL DN_FLOAT
	LIF	0.5
	SQ  3,	H_disp

 hexa_show ' disp ', H_disp
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
	LVA 3,	H_disp
	LA 2,	-GFP_ofs
	LA ,	-NUM__inadr_ofs
	CALLI
	LA 2,	-GFP_ofs
	LA ,	-NUM__ld_ofs
	CALLI
	LVA  2,	-B_ofs
	LA 2,	-GFP_ofs
	LA ,	-NUM__inadr_ofs
	CALLI
	LA  2,	-GFP_ofs
	LA ,	-NUM__ld_ofs
	CALLI
	FMUL
	SQ  3,	H_disp
	LVA 2,	STANDARD.GENBLK_TEST_L1.GEN_PKG.HALF_SUM_L8.R_disp
	LA 2,	-GFP_ofs
	LA ,	-NUM__inadr_ofs
	CALLI
	LA 2,	-GFP_ofs
	LA ,	-NUM__ld_ofs
	CALLI
; CODE_NUMERIC_LITERAL DN_FLOAT
	LIF	0.5
	FMUL
	LVA 3,	H_disp
	LA 2,	-GFP_ofs
	LA ,	-NUM__inadr_ofs
	CALLI
	LA 2,	-GFP_ofs
	LA ,	-NUM__ld_ofs
	CALLI
	FADD
	SQ  2,	STANDARD.GENBLK_TEST_L1.GEN_PKG.HALF_SUM_L8.R_disp
	UNLINK 3
endPRO
; CODE_RETURN : EXPR TYPE = DN_FLOAT  VUE COMPLETE = DN_FLOAT
	LVA 2,	R_disp
	LA 2,	-GFP_ofs
	LA ,	-NUM__inadr_ofs
	CALLI
	LA 2,	-GFP_ofs
	LA ,	-NUM__ld_ofs
	CALLI
	SQ  2,	-result__ofs
	BRA ret_lbl
ret_lbl:
	UNLINK 2
	RTD	prm_siz-8
excep:
endPRO					;---------- end PRO HALF_SUM
end if

if defined NESTED_L9_
PRO	NESTED_L9				;---------- PRO NESTED
 hexa_show 'NESTED_L9 ', $
PRMS					;    debut parametrage
	PRM A_ofs				; in
