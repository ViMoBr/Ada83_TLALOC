	SD  1,	NB_ECHECS_disp

 hexa_show ' disp ', NB_ECHECS_disp
INT_IO = 'INT_IO'
namespace INT_IO				;---------- GENERIC PACKAGE INSTANTIATION
elab_spec:				;    SPEC ELAB

; F4A SET  cle=NUM  actuel=DN_INTEGER
BRA post_LD_NUM
LD_NUM.elab:
	LD -1, 0
	RTD 0
post_LD_NUM:
BRA post_ST_NUM
ST_NUM.elab:
	SD -1, 0
	RTD 0
post_ST_NUM:
BRA post_INADR_NUM
INADR_NUM.elab:
	RTD 0
post_INADR_NUM:
BRA post_OUTADR_NUM
OUTADR_NUM.elab:
	LA
	RTD 0
post_OUTADR_NUM:
VAR NUM__outadr_ofs, Q
	LCA OUTADR_NUM.elab
	SA	 1, NUM__outadr_ofs
VAR NUM__inadr_ofs, Q
	LCA INADR_NUM.elab
	SA	 1, NUM__inadr_ofs
VAR NUM__st_ofs, Q
	LCA ST_NUM.elab
	SA	 1, NUM__st_ofs
VAR NUM__ld_ofs, Q
	LCA LD_NUM.elab
	SA	 1, NUM__ld_ofs
VAR NUM__u_ofs, Q
	LA	 0, STANDARD._INTEGER.use__info
	SA	 1, NUM__u_ofs
VAR GFP_disp, Q				; Lieu du Generic Frame Pointer 
					; CODE_PACKAGE_SPEC
 hexa_show ' spec ', $
 hexa_show 'var elab DEFAULT_WIDTH ', $
VAR DEFAULT_WIDTH_disp, D			; variable entiere
	LI	 11
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  1,	STANDARD.GENBLK_TEST_L1.INT_IO.DEFAULT_WIDTH_disp

 hexa_show ' disp ', DEFAULT_WIDTH_disp
 hexa_show 'var elab DEFAULT_BASE ', $
VAR DEFAULT_BASE_disp, D			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	10
	DUP
	LD	0, STANDARD.TEXT_IO._NUMBER_BASE.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._NUMBER_BASE.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  1,	STANDARD.GENBLK_TEST_L1.INT_IO.DEFAULT_BASE_disp

 hexa_show ' disp ', DEFAULT_BASE_disp
					; sub program entry decl (in instantiation TRUE )
if defined GET_L61_
PRO	GET_L61				;---------- PRO GET
 hexa_show 'GET_L61 ', $
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	LD	 2, -WIDTH_ofs
	LA 	 2, -ITEM_ofs
	LA 	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.INTEGER_IO. ,GET_L61
	UNLINK	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
					; sub program entry decl (in instantiation TRUE )
