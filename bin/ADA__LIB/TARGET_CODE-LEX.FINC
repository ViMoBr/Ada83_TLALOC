LEX = 'LEX'
namespace LEX				;---------- PACKAGE (BDY)
					;    BODY ELAB
FIO = 'FIO'
namespace FIO				;---------- GENERIC PACKAGE INSTANTIATION
elab_spec:				;    SPEC ELAB

; F4A SET  cle=NUM  actuel=DN_FLOAT
BRA post_LD_NUM
LD_NUM.elab:
	LQ -1, 0
	RTD 0
post_LD_NUM:
BRA post_ST_NUM
ST_NUM.elab:
	SQ -1, 0
	RTD 0
post_ST_NUM:
BRA post_INADR_NUM
INADR_NUM.elab:
	RTD 0
post_INADR_NUM:
BRA post_OUTADR_NUM
OUTADR_NUM.elab:
	LA
	RTD 0
post_OUTADR_NUM:
VAR NUM__outadr_ofs, Q
	LCA OUTADR_NUM.elab
	SA	 1, NUM__outadr_ofs
VAR NUM__inadr_ofs, Q
	LCA INADR_NUM.elab
	SA	 1, NUM__inadr_ofs
VAR NUM__st_ofs, Q
	LCA ST_NUM.elab
	SA	 1, NUM__st_ofs
VAR NUM__ld_ofs, Q
	LCA LD_NUM.elab
	SA	 1, NUM__ld_ofs
VAR NUM__u_ofs, Q
	LA	 0, STANDARD._LONG_FLOAT.use__info
	SA	 1, NUM__u_ofs
VAR GFP_disp, Q				; Lieu du Generic Frame Pointer 
					; CODE_PACKAGE_SPEC
 hexa_show ' spec ', $
 hexa_show 'var elab DEFAULT_FORE ', $
VAR DEFAULT_FORE_disp, D			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	2
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  1,	STANDARD.TARGET_CODE_L1.LEX.FIO.DEFAULT_FORE_disp

 hexa_show ' disp ', DEFAULT_FORE_disp
 hexa_show 'var elab DEFAULT_AFT ', $
VAR DEFAULT_AFT_disp, D			; variable entiere
	LI	15
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SUB
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  1,	STANDARD.TARGET_CODE_L1.LEX.FIO.DEFAULT_AFT_disp

 hexa_show ' disp ', DEFAULT_AFT_disp
 hexa_show 'var elab DEFAULT_EXP ', $
VAR DEFAULT_EXP_disp, D			; variable entiere
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	3
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD.TEXT_IO._FIELD.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  1,	STANDARD.TARGET_CODE_L1.LEX.FIO.DEFAULT_EXP_disp

 hexa_show ' disp ', DEFAULT_EXP_disp
					; sub program entry decl (in instantiation TRUE )
if defined GET_L67_
PRO	GET_L67				;---------- PRO GET
 hexa_show 'GET_L67 ', $
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	LD	 2, -WIDTH_ofs
	LA 	 2, -ITEM_ofs
	LA 	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.FLOAT_IO. ,GET_L67
	UNLINKR	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
					; sub program entry decl (in instantiation TRUE )
if defined GET_L68_
PRO	GET_L68				;---------- PRO GET
 hexa_show 'GET_L68 ', $
PRMS					;    debut parametrage
	PRM ITEM_ofs				; out
	PRM WIDTH_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	LD	 2, -WIDTH_ofs
	LA 	 2, -ITEM_ofs
	CALL	STANDARD.TEXT_IO.FLOAT_IO. ,GET_L68
	UNLINKR	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
					; sub program entry decl (in instantiation TRUE )
if defined PUT_L69_
PRO	PUT_L69				;---------- PRO PUT
 hexa_show 'PUT_L69 ', $
PRMS					;    debut parametrage
	PRM FILE_ofs				; in
	PRM ITEM_ofs				; in
	PRM FORE_ofs				; in
	PRM AFT_ofs				; in
	PRM EXP_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	LD	 2, -EXP_ofs
	LD	 2, -AFT_ofs
	LD	 2, -FORE_ofs
	LQ	 2, -ITEM_ofs
	LA 	 2, -FILE_ofs
	CALL	STANDARD.TEXT_IO.FLOAT_IO. ,PUT_L69
	UNLINKR	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
					; sub program entry decl (in instantiation TRUE )
if defined PUT_L70_
PRO	PUT_L70				;---------- PRO PUT
 hexa_show 'PUT_L70 ', $
PRMS					;    debut parametrage
	PRM ITEM_ofs				; in
	PRM FORE_ofs				; in
	PRM AFT_ofs				; in
	PRM EXP_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	LD	 2, -EXP_ofs
	LD	 2, -AFT_ofs
	LD	 2, -FORE_ofs
	LQ	 2, -ITEM_ofs
	CALL	STANDARD.TEXT_IO.FLOAT_IO. ,PUT_L70
	UNLINKR	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
					; sub program entry decl (in instantiation TRUE )
if defined GET_L71_
PRO	GET_L71				;---------- PRO GET
 hexa_show 'GET_L71 ', $
PRMS					;    debut parametrage
	PRM FROM_ofs				; in
	PRM ITEM_ofs				; out
	PRM LAST_ofs				; out
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	LA 	 2, -LAST_ofs
	LA 	 2, -ITEM_ofs
	LA 	 2, -FROM_ofs
	CALL	STANDARD.TEXT_IO.FLOAT_IO. ,GET_L71
	UNLINKR	 2
	RTD	prm_siz
endPRO					;---------- end PRO GET
end if
					; sub program entry decl (in instantiation TRUE )
if defined PUT_L72_
PRO	PUT_L72				;---------- PRO PUT
 hexa_show 'PUT_L72 ', $
PRMS					;    debut parametrage
	PRM TO_ofs				; out
	PRM ITEM_ofs				; in
	PRM AFT_ofs				; in
	PRM EXP_ofs				; in
endPRMS					;    fin parametrage
ELB 2
begin:
	LVA	 1, GFP_disp
	LD	 2, -EXP_ofs
	LD	 2, -AFT_ofs
	LQ	 2, -ITEM_ofs
	LA 	 2, -TO_ofs
	CALL	STANDARD.TEXT_IO.FLOAT_IO. ,PUT_L72
	UNLINKR	 2
	RTD	prm_siz
endPRO					;---------- end PRO PUT
end if
					;---------- end generic package instantiation FIO
end namespace

 hexa_show 'var elab TEXT ', $
_TEXT__type = '_TEXT__type'
namespace _TEXT__type			; array var constrained array type info
VAR use__info, Q
VAR SIZ__, D
	LVA	1, SIZ__
	SA	1, use__info
VAR _COMP_SIZ, D
VAR _FST_1, D
VAR _LST_1, D
	LI	8
	SD	1, _COMP_SIZ
	LD	1, _COMP_SIZ
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	SD	1, _FST_1
; CODE_NUMERIC_LITERAL DN_UNIVERSAL_INTEGER
	LI	50000000
	SD	1, _LST_1
	LD	1, _LST_1
	LD	1, _FST_1
	SUB
	INC
	CLAMP0
	MUL
	SD	1, SIZ__
  virtual at 4
COMP_SIZ = $
	rd 1 
FST_1 = $
	rd 1 
LST_1 = $
	rd 1 
  end virtual
end namespace
VAR TEXT_disp, Q				; variable array : pointeur aux data
VAR TEXT__u, Q				; variable array : useinfo pointeur au rec info
	LA 1, _TEXT__type.use__info
	SA	1, TEXT__u				; array info ptr at __u
	LD	1, _TEXT__type.SIZ__
	LI	8
	DIV
	CO_VAR
	SA	1, TEXT_disp				; array data ptr at _disp

 hexa_show ' disp ', TEXT_disp
 hexa_show 'var elab TEXT_TOP ', $
