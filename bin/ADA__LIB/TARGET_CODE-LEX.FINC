	LA
	BLKMOV
	LIVA 	2, STANDARD.TARGET_CODE_L1.LEX.STORE_L14.R_disp, STANDARD.TARGET_CODE_L1.LEX._SLICE.F
	LD 1,	STANDARD.TARGET_CODE_L1.LEX.TEXT_TOP_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
