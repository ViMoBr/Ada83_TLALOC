if defined SKIP_BLANKS_L35_
PRO	SKIP_BLANKS_L35				;---------- PRO SKIP_BLANKS
 hexa_show 'SKIP_BLANKS_L35 ', $
ELB 2					;    BODY ELAB
					;    end elab
begin:					;---------- BDY INSTRUCTIONS
LOOP__1:
	LD 1,	STANDARD.TARGET_CODE_L1.LEX.POS_disp
	LD 1,	STANDARD.TARGET_CODE_L1.LEX.LEN_disp
	CLE
	DUP
	BF	L39
	DROP
	LA	 1, STANDARD.TARGET_CODE_L1.LEX.LINE_disp	; array data start address on stack
	LD 1,	STANDARD.TARGET_CODE_L1.LEX.POS_disp
	DUP
	LID	1, STANDARD.TARGET_CODE_L1.LEX.LINE__u, STANDARD._STRING.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LID	1, STANDARD.TARGET_CODE_L1.LEX.LINE__u, STANDARD._STRING.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LID	1, STANDARD.TARGET_CODE_L1.LEX.LINE__u, STANDARD._STRING.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LID	1, STANDARD.TARGET_CODE_L1.LEX.LINE__u, STANDARD._STRING.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	ULB
	LI	32
	CEQ
	LA	 1, STANDARD.TARGET_CODE_L1.LEX.LINE_disp	; array data start address on stack
	LD 1,	STANDARD.TARGET_CODE_L1.LEX.POS_disp
	DUP
	LID	1, STANDARD.TARGET_CODE_L1.LEX.LINE__u, STANDARD._STRING.FST_1
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LID	1, STANDARD.TARGET_CODE_L1.LEX.LINE__u, STANDARD._STRING.LST_1
	CGT
	BT	STANDARD.ce_raise_
	LID	1, STANDARD.TARGET_CODE_L1.LEX.LINE__u, STANDARD._STRING.FST_1	; (index - FST_1) * SIZ_1
	SUB
	LID	1, STANDARD.TARGET_CODE_L1.LEX.LINE__u, STANDARD._STRING.COMP_SIZ
	LI	8
	DIV
	MUL
	ADD					; add offset to start address
	ULB
	LI	 9
	CEQ
	OU
L39:
	BF	L38
	LD 1,	STANDARD.TARGET_CODE_L1.LEX.POS_disp
; CODE_NUMERIC_LITERAL DN_INTEGER
	LI	1
	ADD
	DUP
	LD	0, STANDARD._NATURAL.FST
	CLT
	BT	STANDARD.ce_raise_
	DUP
	LD	0, STANDARD._NATURAL.LST
	CGT
	BT	STANDARD.ce_raise_
	SD  1,	STANDARD.TARGET_CODE_L1.LEX.POS_disp
	BRA	LOOP__1
L38:					; post loop LOOP__1
ret_lbl:
	UNLINKR 2
	RTD
excep:
endPRO					;---------- end PRO SKIP_BLANKS
end if

